---
import Badge from './Badge.astro';
import { resolvePath } from '../utils/navigation';

import { Image } from 'astro:assets';
import kohaLogo from "../images/koha.webp";
import { useTranslations } from '../i18n/utils';
const i18n = {
  fi: {
      'Most Popular': 'Suosituin',
      'Koha Library System': 'Koha-kirjastojärjestelmä',
      'Used by thousands of libraries around the world.': 'Tuhansien kirjastojen luottama ratkaisu.',
      'Cloud service': 'Pilvipalvelu',
      'Full access': 'Täydet käyttöoikeudet',
      'Backups & upgrades': 'Varmuuskopiot ja päivitykset',
      'Highly customizable': 'Mukautuu tarpeisiisi',
      'Read more': 'Lue lisää',
      'Toveri Access Control Device': 'Toveri-kulunvalvontalaite',
      'Access control for self-service libraries.': 'Kulunvalvonta itsepalvelukirjastoihin.',
      'Built for extreme weather': 'Kestää äärimmäiset sääolosuhteet',
      'Open standards': 'Avoimet standardit',
      'Two-year warranty': 'Kahden vuoden takuu',
      'Choice of casing materials': 'Valittavissa useita kotelomateriaaleja',
      'Lainuri Checkout Device': 'Lainuri-lainausautomaatti',
      'Self-service checkout for your patrons.': 'Itsepalvelulainaus asiakkailesi.',
      'Quick to install': 'Nopea asentaa',
      'Other': 'Joku muu?',
      'Tell us about your project. We will do our best to help you with Free and Open Source Software.': 'Kerro projektistasi. Autamme mielellämme vapaan ja avoimen lähdekoodin ratkaisuilla.'
  }
};
const t = useTranslations(i18n, Astro);
---

<section id="services" class="py-32 bg-zinc-50 dark:bg-night-soft border-t border-zinc-200 dark:border-night-line">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-8xl mx-auto mb-16 reveal-on-scroll">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">

      <div class="glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-3xl p-8 flex flex-col relative transform shadow-2xl shadow-primary-500/10 reveal-on-scroll" style="transition-delay: 100ms;">
        <div class="absolute -top-4 left-1/4 -translate-x-1/2">
          <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Most Popular')}</Badge> 
        </div>
        <h3 class="text-2xl font-heading font-bold text-zinc-900 dark:text-white mb-2">{t('Koha Library System')}</h3>
        <Image src={kohaLogo} alt="Koha" class="mx-auto mb-2" width={200} densities={[1, 2]} loading="lazy" decoding="async" />
        <p class="text-zinc-500 dark:text-zinc-400 text-sm mb-8">{t('Used by thousands of libraries around the world.')}</p>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-300 flex-grow">
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Cloud service')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Full access')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Backups & upgrades')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Highly customizable')}</li>
        </ul>
        <a href={resolvePath('/koha/')} class="inline-flex items-center justify-center px-8 py-4 mt-4 text-lg font-bold rounded-xl bg-primary-100 text-primary-600 hover:bg-zinc-50 hover:scale-105 transition-all shadow-2xl shadow-white/10">
          {t('Read more')}
        </a>
      </div>

      <!-- Pro Plan -->
      <div class="glass-panel rounded-3xl p-8 flex flex-col reveal-on-scroll" style="transition-delay: 200ms;">
        
        <h3 class="text-2xl font-heading font-bold text-zinc-900 dark:text-white mb-2">{t('Toveri Access Control Device')}</h3>
        <p class="text-zinc-500 dark:text-zinc-400 text-sm mb-14 mt-8">{t('Access control for self-service libraries.')}</p>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-300 flex-grow">
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Built for extreme weather')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Open standards')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Two-year warranty')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Choice of casing materials')}</li>
        </ul>
        <a href={resolvePath('/toveri-access-control-device/')} class="inline-flex items-center justify-center px-8 py-4 mt-4 text-lg font-bold border-2 border-zinc-200 dark:border-night-line-strong rounded-xl text-zinc-700 dark:text-zinc-400 hover:scale-105 transition-all shadow-2xl shadow-black/10">
          {t('Read more')}
        </a>
      </div>

      <!-- Enterprise Plan -->
      <div class="glass-panel rounded-3xl p-8 flex flex-col reveal-on-scroll" style="transition-delay: 200ms;">
        <h3 class="text-2xl font-heading font-bold text-zinc-900 dark:text-white mb-2">{t('Lainuri Checkout Device')}</h3>
        <p class="text-zinc-500 dark:text-zinc-400 text-sm mb-8 mt-8">{t('Self-service checkout for your patrons.')}</p>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-300 flex-grow">
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Quick to install')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Open standards')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Two-year warranty')}</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {t('Choice of casing materials')}</li>
        </ul>
        <a href={resolvePath('/lainuri-checkout-machine/')} class="inline-flex items-center justify-center px-8 py-4 mt-4 text-lg font-bold border-2 border-zinc-200 dark:border-night-line-strong rounded-xl text-zinc-700 dark:text-zinc-400 hover:scale-105 transition-all shadow-2xl shadow-black/10">
          {t('Read more')}
        </a>
      </div>

      <div class="glass-panel rounded-3xl p-8 flex flex-col reveal-on-scroll" style="transition-delay: 200ms;">
        <h3 class="text-2xl font-heading font-bold text-zinc-900 dark:text-white mb-10">{t('Other')}</h3>
        <p class="text-zinc-500 dark:text-zinc-400 text-sm mb-8">{t('Tell us about your project. We will do our best to help you with Free and Open Source Software.')}</p>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-300 flex-grow">
        </ul>
        <a href={resolvePath('/contact/')} class="inline-flex items-center justify-center px-8 py-4 mt-4 text-lg font-bold border-2 border-zinc-200 dark:border-night-line-strong rounded-xl text-zinc-700 dark:text-zinc-400 hover:scale-105 transition-all shadow-2xl shadow-black/10">
          {t('Read more')}
        </a>
      </div>
    </div>
  </div>
  </div>
</section>