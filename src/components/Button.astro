---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className, ...props } = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-night active:scale-[0.98]";

const variants = {
  primary: "bg-primary-600 dark:bg-primary-500 text-white hover:bg-primary-700 dark:hover:bg-primary-400 focus:ring-primary-500 shadow-sm",
  secondary: "bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-100 focus:ring-zinc-900 dark:focus:ring-white shadow-sm",
  outline: "border-2 border-zinc-200 dark:border-night-line-strong bg-transparent text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-600 hover:bg-zinc-50 dark:hover:bg-night-raise focus:ring-zinc-500",
  ghost: "text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-night-raise hover:text-zinc-900 dark:hover:text-white focus:ring-zinc-500",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-2.5 text-base",
  lg: "px-8 py-3.5 text-lg",
};

const Element = href ? 'a' : 'button';
const combinedClasses = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className || ''}`;
---

<Element href={href} class={combinedClasses} {...props}>
  <slot />
</Element>