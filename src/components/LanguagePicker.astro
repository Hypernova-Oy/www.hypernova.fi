---
import { languages } from '../i18n/ui';

interface Props {
  /**
   * `inline` is the control the desktop nav bar lays out after its own links.
   * `menu` draws a full-width row, so the picker inside the mobile menu is as easy
   * to tap as the navigation links above it: Tailwind's preflight leaves a bare
   * `a` unstyled, with no padding to aim at.
   */
  variant?: 'inline' | 'menu';
}

const { variant = 'inline' } = Astro.props;
const currentLang = Astro.locals.lang;

/*
 * The bar around it is bare text, so the picker carries a surface of its own: filled in
 * both themes, the same size as the links it follows rather than the 16px a bare link
 * would inherit, and rounded, so the flag reads as a control and not as loose glyphs.
 * The light-mode fill is a tint of the bar - `primary-100` under `primary-800`, the
 * pairing a Badge gives a label - rather than the solid-control colour `primary-600`: as
 * a pill of near-black ink it was the heaviest thing in a bar whose other controls stay
 * quiet until they are hovered, and it read as a competitor to the page's own calls to
 * action. It still has to be a surface of its own, which is why it is a tint rather than
 * no fill at all. Dark mode keeps `night-raise`, a surface raised above the bar it is
 * drawn on; the tint deepens one step on hover in each theme.
 */
const linkClass =
  variant === 'menu'
    ? 'flex items-center gap-3 rounded-md px-3 py-2 text-base font-medium text-zinc-700 transition-colors hover:bg-zinc-50 hover:text-primary-600 dark:text-zinc-300 dark:hover:bg-night-raise dark:hover:text-primary-400'
    : 'inline-flex items-center gap-1.5 rounded-full border border-primary-200 bg-primary-100 px-2 py-1 text-sm font-medium text-primary-800 transition-colors hover:bg-primary-200 dark:border-night-line-strong dark:bg-night-raise dark:text-zinc-100 dark:hover:bg-night-line dark:hover:text-primary-400';
---
<ul class={variant === 'menu' ? 'space-y-1' : undefined}>
  {Object.entries(languages).map(([lang, label]) => (
    <li>
      {lang!==currentLang ? (
        <a href={`?l=${lang}`} class={linkClass}><span class={`fi fi-${lang}`}></span> {label}</a>
      ) : (
        <a href={`?l=${lang}`} class="hidden">{label}</a>
      )}
    </li>
  ))}
</ul>

<style>
  /*
   * The flag marks the picker draws, without the flag-icons stylesheet it used to
   * import. The package ships one rule per country - about 250 of them, most
   * carrying a base64 copy of the flag - and the site can show two: `gb` and `fi`,
   * the languages of src/i18n/ui.ts. Imported for its two useful rules it put
   * 421 KB of CSS into every page of the site (measured: a page was 563 KB, of
   * which 421 KB was flags), so the two files it needs were copied to
   * src/images/flags and the rules the markup relies on are written out here.
   *
   * These are those rules, as the package has them: the box (1.333333em wide, one
   * line tall - the `:before` space is what gives the empty span its height) and
   * the two backgrounds. They are two files under /_astro/, not data: URLs in the sheet:
   * `assetsInlineLimit: 0` in astro.config.mjs keeps every asset a file of its own. Both SVGs
   * are the MIT-licensed
   * flag-icons files (flags/4x3 in that package), renamed to the language codes this
   * component builds the class name from; the package itself was uninstalled, so a
   * third language means copying one more of its files here.
   */
  .fi {
    position: relative;
    display: inline-block;
    width: 1.333333em;
    line-height: 1em;
    background-size: contain;
    background-position: 50%;
    background-repeat: no-repeat;
  }

  /*
   * A non-breaking space, exactly as the package has it, and not a plain one: the
   * picker is a flex pill, so this span is blockified and a collapsible space leaves it
   * with no height at all. The flag then draws into a zero-height box - invisible - and
   * the pill loses the height the flag gives it, which moved the pill off the centre of
   * the links beside it.
   */
  .fi:before {
    content: '\00a0';
  }

  .fi-gb {
    background-image: url('../images/flags/gb.svg');
  }

  .fi-fi {
    background-image: url('../images/flags/fi.svg');
  }
</style>
