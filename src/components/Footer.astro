---
import { Image } from 'astro:assets';
import Badge from './Badge.astro';
import { FOOTER_LINKS, BRAND_NAME, SITE_DESCRIPTION, SITE_DESCRIPTION_I18N, SOCIAL_LINKS } from '../config';
import { resolvePath } from '../utils/navigation';
import hypernovaLogo from '../images/hypernova-logo.png';
import { FALLBACK_LANG, isLanguage, type i18n, type Language } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const i18n: i18n = {
  fi: {
    'Why FOSS': 'Miksi vapaa koodi',
    'Services': 'Palvelut',
    'Our Services': 'Palvelumme',
    'For Clients': 'Asiakkaillemme',
    'Support': 'Tikettipalvelu',
    'Company': 'Yritys',
    'Contact': 'Yhteystiedot',
    'Privacy Policy': 'Tietosuojaseloste',
    'Terms of Service': 'Palveluehdot',
    // The credits line at the bottom. It is broken around the three links it carries, so
    // each piece around a link is translated on its own and the names stay as they are.
    'All rights reserved. Built on': 'Kaikki oikeudet pidätetään. Rakennettu',
    ' web framework. Theme "': '-verkkokehyksellä. Teema "',
    '", a fork of "': '", joka on "',
    // The trust badge under the tagline. It is not one sentence translated twice: the Finnish
    // pages make the Finnish claim a domestic buyer is looking for, and the English pages the
    // one a reader abroad is, each with the flag that belongs to it (TRUST_FLAG below). The
    // English key is the English sentence, as everywhere else in these dictionaries.
    'GDPR and privacy first': 'Kotimaista laatutyötä',
    '".': '"-teeman haarautuma.'
  }
};
i18n['fi'][SITE_DESCRIPTION] = SITE_DESCRIPTION_I18N['fi'];
const t = useTranslations(i18n, Astro);

const lang: Language = isLanguage(Astro.locals.lang) ? Astro.locals.lang : FALLBACK_LANG;

/**
 * The flag the trust badge wears, per language: Finland on the Finnish pages, the European Union
 * on the English ones, in each case the flag of the claim written beside it. `Badge.astro` draws
 * the mark from `src/images/flags` and holds the rules for both files.
 */
const TRUST_FLAG: Record<Language, 'fi' | 'eu'> = { fi: 'fi', en: 'eu' };
---

<footer class="bg-white dark:bg-night border-t border-zinc-200 dark:border-night-line pt-16 pb-8 transition-colors">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[minmax(280px,1.35fr)_repeat(3,minmax(140px,1fr))] lg:gap-10 mb-12">
      <!-- Brand & Newsletter -->
      <div>
        <a href={resolvePath('/')} class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 dark:bg-white rounded-lg flex items-center justify-center transition-transform group-hover:scale-105">
            <Image src={hypernovaLogo} alt="Hypernova Oy" layout='constrained' width={32} height={32} />
          </div>
          <span class="brand-font text-xl text-zinc-900 dark:text-white">{BRAND_NAME}</span>
        </a>
        <p class="text-zinc-600 dark:text-zinc-400 text-sm mb-6">
          {t(SITE_DESCRIPTION)}
        </p>
        <Badge variant="neutral" flag={TRUST_FLAG[lang]}>{t('GDPR and privacy first')}</Badge>
      </div>

      <!-- Links -->
      {FOOTER_LINKS.map(group => (
        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-4">{t(group.title)}</h3>
          <ul class="space-y-3">
            {group.links.map(link => (
              <li>
                <a href={resolvePath(link.href)} class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                  {t(link.label)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-zinc-200 dark:border-night-line pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        &copy; {new Date().getFullYear()} Hypernova Oy. {t('All rights reserved. Built on')} <a href="https://astro.build" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors" target="_blank" rel="noopener noreferrer">Astro</a>{t(' web framework. Theme "')}<a href="https://github.com/Hypernova-Oy/www.hypernova.fi" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors" target="_blank" rel="noopener noreferrer">hypernova</a>{t('", a fork of "')}<a href="https://github.com/farrosfr/zenix" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors" target="_blank" rel="noopener noreferrer">Zenix</a>{t('".')}
      </p>
      
      <!-- Social Icons -->
      <div class="flex gap-4 text-zinc-500 dark:text-zinc-400">
        <a href={SOCIAL_LINKS.github} class="hover:text-zinc-600 dark:hover:text-zinc-300" target="_blank" rel="noopener noreferrer">
          <span class="sr-only">GitHub</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

