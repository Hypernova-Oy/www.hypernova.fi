---
interface Props {
  variant?: 'primary' | 'success' | 'warning' | 'error' | 'neutral';
  /**
   * A country flag drawn before the label, for the badges that make a claim about where the
   * company or the data is. The mark is decorative - the label beside it carries the meaning -
   * and the file it draws is in `src/images/flags`.
   */
  flag?: 'fi';
  class?: string;
}

const { variant = 'primary', flag, class: className = '' } = Astro.props;

const baseStyles = "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase";

const variants = {
  primary: "bg-primary-100 dark:bg-primary-900/30 text-primary-800 dark:text-primary-300 border border-primary-200 dark:border-primary-800",
  success: "bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-800",
  warning: "bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800",
  error: "bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800",
  neutral: "bg-zinc-100 dark:bg-night-raise text-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-night-line-strong",
};

const combinedClasses = `${baseStyles} ${variants[variant]} ${flag ? 'gap-1.5' : ''} ${className}`;
---

<span class={combinedClasses}>
  {flag && <span class={`badge-flag badge-flag-${flag}`} aria-hidden="true"></span>}
  <slot />
</span>

<style>
  /*
   * The flag mark. Its file is one of the MIT-licensed flag-icons ones the picker's flags came
   * from, copied into src/images/flags next to them (see LanguagePicker.astro for why the
   * package's stylesheet is not imported). `assetsInlineLimit: 0` in astro.config.mjs keeps it
   * out of the stylesheet, so a marked badge is one small file under /_astro/ (fi.svg is 234 B),
   * fetched and cached like every other asset.
   *
   * The box is the flag's own 4:3: an empty span has no height of its own, and
   * `background-size: contain` on a zero-high box draws nothing. `flex: none` keeps the label
   * the thing that decides how wide the pill is.
   *
   * The names are `badge-flag-*`, deliberately not the `fi-*` shape the picker builds from a
   * language code: the e2e case *the language picker draws its own flag* counts the rules on a
   * page that read as a country flag and allows two - the pair the picker draws - so a third
   * rule shaped like one fails a page check over a mark that costs about a kilobyte.
   * tests/unit/trust-badge.test.ts holds that, and the translation and flag behind the footer
   * badge this was added for.
   */
  .badge-flag {
    display: inline-block;
    flex: none;
    width: 1.333333em;
    aspect-ratio: 4 / 3;
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: contain;
  }

  .badge-flag-fi {
    background-image: url('../images/flags/fi.svg');
  }
</style>
