---
import Button from './Button.astro';

import { resolvePath } from '../utils/navigation';
import { useTranslations } from '../i18n/utils';
const i18n = {
  fi: {
      'Free & Open': 'Vapaa ja avoin',
      'Source Software': 'lähdekoodi',
      'No vendor lock-ins. Privacy-friendly. Cost-effective.': 'Ei toimittajaloukkuja. Yksityisyys ja läpinäkyvyys edellä. Kustannustehokas ratkaisu.',
      'Our Services': 'Palvelumme',
      'Why Free and Open Source?': 'Miksi vapaa ja avoin lähdekoodi?',
  }
};
const t = useTranslations(i18n, Astro);
---

<section class="relative pt-32 pb-32 lg:pt-48 lg:pb-40 overflow-hidden">
  <!-- Complex Animated Background -->
  <div class="absolute inset-0 -z-10 bg-white dark:bg-night">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCI+CjxyZWN0IHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgZmlsbD0ibm9uZSI+PC9yZWN0Pgo8Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0icmdiYSgwLDAsMCwwLjA1KSI+PC9jaXJjbGU+Cjwvc3ZnPg==')] dark:bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCI+CjxyZWN0IHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgZmlsbD0ibm9uZSI+PC9yZWN0Pgo8Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0icmdiYSgyNTUsMjU1LDI1NSwwLjA1KSI+PC9jaXJjbGU+Cjwvc3ZnPg==')] [mask-image:linear-gradient(to_bottom,white,transparent)]"></div>
    <div class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 w-[800px] h-[600px] bg-primary-400/20 dark:bg-primary-900/30 rounded-full blur-[64px] opacity-80 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 w-[600px] h-[500px] bg-accent-400/20 dark:bg-accent-900/30 rounded-full blur-[56px] opacity-80 pointer-events-none"></div>
  </div>
  
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-on-scroll">
    
    <h1 class="text-6xl sm:text-7xl lg:text-8xl font-heading font-extrabold tracking-tight text-zinc-900 dark:text-white mb-8 max-w-5xl mx-auto leading-[1.1]">
      {t('Free & Open')} <span class="text-gradient">{t('Source Software')}.</span>
    </h1>
    
    <p class="text-xl sm:text-2xl text-zinc-600 dark:text-zinc-400 mb-12 max-w-3xl mx-auto font-sans leading-relaxed">
      {t('No vendor lock-ins. Privacy-friendly. Cost-effective.')}
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
      <Button href={resolvePath('/services/')} variant="primary" size="lg" class="w-full sm:w-auto text-lg px-8 py-4 shadow-xl shadow-primary-500/20">
        {t('Our Services')}
      </Button>
      <Button href="#whyfoss" variant="outline" size="lg" class="w-full sm:w-auto text-lg px-8 py-4 bg-white/50 dark:bg-night-card/50 backdrop-blur-sm">
        {t('Why Free and Open Source?')}
      </Button>
    </div>
  </div>
</section>
