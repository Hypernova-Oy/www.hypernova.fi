---
import { resolvePath } from '../utils/navigation';
import { useTranslations } from '../i18n/utils';

const i18n = {
  fi: {
    'Search': 'Haku',
    'Search pages and services': 'Hae sivuja ja palveluita',
    'Search the site': 'Hae sivustolta',
    'Type to find services and pages. Press Ctrl+K to open search from any page.':
      'Kirjoita hakeaksesi palveluita ja sivuja. Avaa haku millä tahansa sivulla painamalla Ctrl+K.',
    'No results found for that query.': 'Ei tuloksia haulla.',
  },
};

const t = useTranslations(i18n, Astro);
---

<div
  id="command-palette"
  class="fixed inset-0 z-[100] hidden isolate overflow-y-auto p-4 sm:p-6 md:p-20"
  role="dialog"
  aria-modal="true"
  aria-label={t('Search')}
>
  <!-- Backdrop -->
  <div data-command-backdrop class="fixed inset-0 z-0 bg-zinc-900/60 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>

  <!-- Palette -->
  <div class="relative z-10 mx-auto max-w-2xl transform divide-y divide-zinc-100 dark:divide-night-line overflow-hidden rounded-2xl bg-white dark:bg-night-card shadow-2xl ring-1 ring-zinc-900/5 transition-all">
    <div class="relative">
      <svg
        class="pointer-events-none absolute left-4 top-3.5 h-5 w-5 text-zinc-400"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
          clip-rule="evenodd"></path>
      </svg>
      <input
        type="text"
        id="search-input"
        class="h-12 w-full border-0 bg-transparent pl-11 pr-4 text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:ring-0 sm:text-sm"
        placeholder={t('Search pages and services')}
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="search-results"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <!-- Results list (filled in by the script below) -->
    <ul
      class="max-h-96 scroll-py-3 overflow-y-auto p-3 hidden"
      id="search-results"
      role="listbox"
      aria-label={t('Search')}
    ></ul>

    <!-- Empty state / help -->
    <div id="search-help" class="px-6 py-14 text-center sm:px-14">
      <svg
        class="mx-auto h-6 w-6 text-zinc-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
      </svg>
      <p class="mt-4 text-sm text-zinc-900 dark:text-white font-medium">{t('Search the site')}</p>
      <p class="mt-2 text-sm text-zinc-500">{t('Type to find services and pages. Press Ctrl+K to open search from any page.')}</p>
    </div>
  </div>
</div>

<style is:global>
  /*
   * The rows are injected at runtime, so their highlight cannot use scoped
   * styles. One rule covers both mouse hover and keyboard selection.
   */
  #search-results [role='option']:hover,
  #search-results [role='option'][aria-selected='true'] {
    background-color: var(--color-primary-600);
  }

  .dark #search-results [role='option']:hover,
  .dark #search-results [role='option'][aria-selected='true'] {
    background-color: var(--color-night-raise);
  }

  /*
   * The selected row sits on a lifted surface, so the description and the snippet
   * that shows where a word was matched need more light.
   */
  .dark #search-results [role='option']:hover .palette-description,
  .dark #search-results [role='option']:hover .palette-snippet,
  .dark #search-results [role='option'][aria-selected='true'] .palette-description,
  .dark #search-results [role='option'][aria-selected='true'] .palette-snippet {
    color: var(--color-primary-200);
  }

  #search-results [role='option']:hover .palette-badge,
  #search-results [role='option'][aria-selected='true'] .palette-badge {
    background-color: rgb(255 255 255 / 0.2);
  }

  #search-results [role='option']:hover .palette-badge-text,
  #search-results [role='option']:hover .palette-title,
  #search-results [role='option'][aria-selected='true'] .palette-badge-text,
  #search-results [role='option'][aria-selected='true'] .palette-title {
    color: #fff;
  }

  #search-results [role='option']:hover .palette-description,
  #search-results [role='option']:hover .palette-snippet,
  #search-results [role='option'][aria-selected='true'] .palette-description,
  #search-results [role='option'][aria-selected='true'] .palette-snippet {
    color: var(--color-primary-100);
  }

  /*
   * A word the query matched. The teal accent is the only chromatic brand colour,
   * so the highlight is a pale teal on the light surfaces and a deep teal tint on
   * the dark ones. Both read on the row itself and on the selected row (near-black
   * in light mode, lifted in dark mode), so no selected-row variant is needed.
   */
  #search-results mark {
    border-radius: 0.25rem;
    padding: 0 0.15em;
    background-color: var(--color-accent-100);
    color: var(--color-accent-900);
  }

  .dark #search-results mark {
    background-color: color-mix(in srgb, var(--color-accent-500) 30%, transparent);
    color: var(--color-accent-100);
  }
</style>

<script is:inline define:vars={{ resolvePath: resolvePath('/'), noResultsMessage: t('No results found for that query.') }}>
  // define:vars hands the base path and the localized messages to this inline script.

  function setupSearch() {
    const palette = document.getElementById('command-palette');
    const input = document.getElementById('search-input');
    const resultsList = document.getElementById('search-results');
    const helpState = document.getElementById('search-help');
    const backdrop = palette?.querySelector('[data-command-backdrop]');

    if (!palette || !input || !resultsList || !helpState) return;

    /*
     * `astro:page-load` fires for the first load as well, so this runs twice on every
     * page. Bail out here, before anything else is set up: a run that stopped halfway
     * would still leave its own `toggleCommandPalette` published while the listeners
     * stayed with the first run.
     */
    if (palette.dataset.searchBound === 'true') return;
    palette.dataset.searchBound = 'true';

    window.__zenixSearchIndex = window.__zenixSearchIndex || [];
    window.__zenixSearchLoaded = window.__zenixSearchLoaded || false;

    let activeIndex = -1;

    async function loadIndex() {
      // The index is localized, so it has to be refetched when the language
      // changes without a full page load (view transitions).
      const lang = document.documentElement.lang || 'any';
      if (window.__zenixSearchLoaded && window.__zenixSearchLang === lang) return;

      try {
        const response = await fetch(`${resolvePath}search-index.json`, {
          headers: { Accept: 'application/json' }
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        window.__zenixSearchIndex = await response.json();
        window.__zenixSearchLoaded = true;
        window.__zenixSearchLang = lang;

        const query = input.value.toLowerCase().trim();
        if (query) {
          renderResults(getMatches(query), query);
        }
      } catch (err) {
        console.error('Failed to load search index:', err);
      }
    }

    function getMatches(query) {
      const terms = queryTerms(query);
      if (terms.length === 0) return [];

      // `keywords` carries the searchable text of both languages, `content` the
      // text of the page itself in the language the visitor is reading.
      return window.__zenixSearchIndex.filter((item) => {
        const haystack = [item.title, item.description, item.keywords, item.content]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();
        // Every word of the query has to appear in the entry.
        return terms.every((term) => haystack.includes(term));
      });
    }

    function getOptions() {
      return Array.from(resultsList.querySelectorAll('[role="option"]'));
    }

    function setActive(index) {
      const options = getOptions();
      const next = index >= 0 && index < options.length ? index : -1;

      options.forEach((option, optionIndex) => {
        option.setAttribute('aria-selected', String(optionIndex === next));
      });

      activeIndex = next;
      input.setAttribute('aria-activedescendant', next >= 0 ? options[next].id : '');
      if (next >= 0) options[next].scrollIntoView({ block: 'nearest' });
    }

    function openResult() {
      if (resultsList.classList.contains('hidden')) return false;

      // An explicit selection wins; otherwise Enter opens the best match.
      const option = getOptions()[activeIndex >= 0 ? activeIndex : 0];
      const link = option?.querySelector('a');
      if (!link) return false;

      togglePalette();
      link.click();
      return true;
    }

    function togglePalette() {
      const isHidden = palette.classList.contains('hidden');
      if (isHidden) {
        palette.classList.remove('hidden');
        loadIndex();
        input.focus();
        document.body.style.overflow = 'hidden';
      } else {
        palette.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    window.toggleCommandPalette = togglePalette;

    if (!window.__zenixSearchKeyBound) {
      window.__zenixSearchKeyBound = true;
      window.addEventListener('keydown', (e) => {
        const activePalette = document.getElementById('command-palette');

        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.toggleCommandPalette?.();
          return;
        }

        if (e.key === 'Escape' && activePalette && !activePalette.classList.contains('hidden')) {
          window.toggleCommandPalette?.();
        }
      });
    }

    // Click the backdrop to close.
    palette.addEventListener('click', (e) => {
      if (e.target === palette || e.target === backdrop) {
        togglePalette();
      }
    });

    input.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();

      if (!query) {
        resultsList.classList.add('hidden');
        helpState.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'false');
        setActive(-1);
        resultsList.innerHTML = '';
        return;
      }

      renderResults(getMatches(query), query);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (resultsList.classList.contains('hidden')) return;

        const options = getOptions();
        if (options.length === 0) return;

        e.preventDefault();
        const step = e.key === 'ArrowDown' ? 1 : -1;
        const next = activeIndex === -1
          ? (step === 1 ? 0 : options.length - 1)
          : (activeIndex + step + options.length) % options.length;

        setActive(next);
        return;
      }

      if (e.key === 'Enter' && openResult()) {
        e.preventDefault();
      }
    });

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[char]);
    }

    /** The words of a query: every one of them has to match, and all of them are highlighted. */
    function queryTerms(query) {
      return query.split(/\s+/).filter(Boolean);
    }

    /**
     * A pattern that finds any of the terms. The terms are typed by the visitor, so
     * regular-expression syntax in them (a `?` or a bracket, for example) is escaped
     * and matched as the plain text it is.
     */
    function termPattern(terms, flags) {
      const escaped = terms.map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      return new RegExp(escaped.join('|'), flags);
    }

    /**
     * The text with every matched word wrapped in a <mark>. The text is escaped
     * first, so neither the index nor the query can inject markup into the palette.
     */
    function highlight(text, terms) {
      if (!text || terms.length === 0) return escapeHtml(text);

      const pattern = termPattern(terms, 'gi');
      let html = '';
      let last = 0;

      for (const match of text.matchAll(pattern)) {
        html += escapeHtml(text.slice(last, match.index)) + `<mark>${escapeHtml(match[0])}</mark>`;
        last = match.index + match[0].length;
      }

      return html + escapeHtml(text.slice(last));
    }

    /** How much text is shown around a matched word in a snippet. */
    const SNIPPET_RADIUS = 50;

    /**
     * The slice of the page text shown around a match: SNIPPET_RADIUS characters
     * each way, pulled back to word boundaries so that no word is cut in half.
     */
    function windowAround(text, index, length) {
      let start = Math.max(0, index - SNIPPET_RADIUS);
      let end = Math.min(text.length, index + length + SNIPPET_RADIUS);

      if (start > 0) {
        const space = text.indexOf(' ', start);
        if (space !== -1 && space < index) start = space + 1;
      }

      if (end < text.length) {
        const space = text.lastIndexOf(' ', end);
        if (space > index + length) end = space;
      }

      return { start, end, text: text.slice(start, end).trim() };
    }

    /**
     * A short piece of the page text around the words that the row itself does not
     * show, so a match in the body of a page is visible and highlighted as well. The
     * window holding most of those words wins, which keeps words that belong together
     * (a phrase, for example) in one snippet. An empty string means the body text does
     * not hold them: they matched a hidden keyword instead.
     */
    function bodySnippet(content, terms) {
      if (!content || terms.length === 0) return '';

      const pattern = termPattern(terms, 'gi');
      let best = null;

      for (const match of content.matchAll(pattern)) {
        const window = windowAround(content, match.index, match[0].length);
        const found = terms.filter((term) => window.text.toLowerCase().includes(term)).length;

        if (!best || found > best.found) best = { ...window, found };
        if (found === terms.length) break; // Every word is in view, nothing better to find.
      }

      if (!best) return '';

      const lead = best.start > 0 ? '… ' : '';
      const trail = best.end < content.length ? ' …' : '';
      return `${lead}${highlight(best.text, terms)}${trail}`;
    }

    function renderResults(matches, query) {
      helpState.classList.add('hidden');
      resultsList.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
      setActive(-1);

      if (matches.length === 0) {
        resultsList.innerHTML = `
          <li class="px-4 py-14 text-center sm:px-14">
            <p class="text-sm text-zinc-500">${escapeHtml(noResultsMessage)}</p>
          </li>
        `;
        return;
      }

      const terms = queryTerms(query);

      resultsList.innerHTML = matches.map((item, index) => {
        const target = `${resolvePath}${item.slug.startsWith('/') ? item.slug.slice(1) : item.slug}`;

        // A word that the title and the description do not show can only come from
        // `keywords` or from the text of the page. The first case has nothing to
        // point at, the second one gets a snippet of the sentence it was found in.
        const visible = `${item.title} ${item.description}`.toLowerCase();
        const hidden = terms.filter((term) => !visible.includes(term));
        const snippet = hidden.length > 0 ? bodySnippet(item.content, hidden) : '';

        return `
        <li
          id="search-option-${index}"
          class="cursor-pointer select-none rounded-xl p-3 transition-colors"
          role="option"
          aria-selected="false"
        >
          <a href="${escapeHtml(target)}" class="flex items-center">
            <div class="palette-badge flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-zinc-100 dark:bg-night-raise">
              <span class="palette-badge-text text-xs font-bold text-zinc-500 dark:text-zinc-400 uppercase">${escapeHtml(item.type.charAt(0))}</span>
            </div>
            <div class="ml-4 flex-auto">
              <p class="palette-title text-sm font-medium text-zinc-900 dark:text-white">${highlight(item.title, terms)}</p>
              <p class="palette-description text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">${highlight(item.description, terms)}</p>
              ${snippet ? `<p class="palette-snippet mt-0.5 text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">${snippet}</p>` : ''}
            </div>
          </a>
        </li>
      `;
      }).join('');
    }

  }

  // Setup on page load and view transition
  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
</script>
