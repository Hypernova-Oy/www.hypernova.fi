---
import hypernovaLogo from '../images/hypernova-logo.png';
import LanguagePicker from '../components/LanguagePicker.astro';

import { Font } from "astro:assets";
import { Image } from 'astro:assets';
import { NAV_LINKS, BRAND_NAME } from '../config';
import { useTranslations } from '../i18n/utils';
import { resolvePath } from '../utils/navigation';

const i18n = {
  fi: {
      'Why FOSS': 'Miksi avoin koodi',
      'Services': 'Palvelut',
      'Koha Cloud Hosting': 'Koha-pilvipalvelu',
      'Contact': 'Yhteystiedot',
      'Search': 'Haku',
      'Language': 'Kieli',
      'Open main menu': 'Avaa päävalikko',
  }
};
const t = useTranslations(i18n, Astro);

/**
 * The page the visitor is on, in the trailing-slash form the links of the bar are written in.
 */
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

/** The page a link points at: its path, with the fragment that names a section of it dropped. */
function linkedPath(href: string) {
  const path = resolvePath(href).split('#')[0];

  return path.endsWith('/') ? path : `${path}/`;
}

/**
 * What a link in the bar says about where the visitor already is, which is nothing until the
 * link names this page.
 *
 * A screen reader otherwise reads the bar as five destinations with no way to tell which one
 * is the page under it - the styling of the bar marks nothing either, every link is the same
 * grey until it is hovered - so the page the visitor is on carries `aria-current="page"` and
 * a link into a section of it carries `aria-current="location"`. That pair is what ARIA draws
 * for the two cases: two of these links (`/#whyfoss`, `/koha/#cloud-hosting-service`) do not
 * leave their page at all, and calling them the current *page* would announce the same page
 * twice on /koha/, once for the page and once for a heading inside it.
 *
 * The comparison drops the fragment, so the links are matched on the page they point at, and
 * the anchors of the two pages above are marked from `/` and from `/koha/` alike. This does
 * not need the request language: `?l=` is not part of a path.
 */
function currentMarker(href: string) {
  if (linkedPath(href) !== currentPath) return undefined;

  return href.includes('#') ? 'location' : 'page';
}
---

<!--
  The bar is a solid surface, not a glass panel: the page scrolls underneath it, and a
  translucent fill let the copy behind it show through the links. The two fills are the
  ones the mobile menu panel below already uses, so the menu still sits seamlessly in the
  bar when it opens.
-->
<header class="sticky top-0 z-[90] w-full transition-colors duration-300 bg-white dark:bg-night-card border border-zinc-200/50 dark:border-night-line/50 border-x-0 border-t-0 rounded-none shadow-sm pointer-events-auto">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href={resolvePath('/')} class="flex items-center gap-2 group">
          <div class="w-8 h-8 dark:bg-white rounded-lg flex items-center justify-center transition-transform group-hover:scale-105">
            <Image src={hypernovaLogo} alt="Hypernova Oy" layout='constrained' width={32} height={32} loading="eager" />
          </div>
          <Font cssVariable="--font-ocra" preload />
          <span class="brand-font text-xl text-zinc-900 dark:text-white transition-colors">{BRAND_NAME}</span>
        </a>
      </div>

      <!--
        Desktop Navigation

        The bar is tight from a wide screen down, and the Finnish labels are the longest,
        so a hairline carries the separation between the items and the gap between them
        is only widened back out once the row has room for it again (re-measured at 768,
        1024 and 1280px). The hairline itself starts at lg, where the row stops wrapping.
      -->
      <nav class="hidden md:flex items-center gap-3 lg:gap-2 xl:gap-5">
        {NAV_LINKS.map((link, index) => (
          <>
            {index > 0 && (
              <span data-nav-separator aria-hidden="true" class="hidden lg:block h-4 w-px bg-zinc-200 dark:bg-night-line"></span>
            )}
            <a href={resolvePath(link.href)} aria-current={currentMarker(link.href)} class="text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
              {t(link.label)}
            </a>
          </>
        ))}
        <!-- The language picker rides along with the links, so it is divided off as well. -->
        <span data-nav-separator aria-hidden="true" class="hidden lg:block h-4 w-px bg-zinc-200 dark:bg-night-line"></span>
        <LanguagePicker />
      </nav>

      <!-- CTA Buttons & Theme Toggle (Desktop) -->
      <div class="hidden md:flex items-center gap-4">
        <!--
          Search button. It asks the palette to open through `data-search-trigger` and not through
          an inline `onclick`: `script-src` has no 'unsafe-inline' and a bare hash does not cover
          an attribute, so a browser refuses an inline handler and the button does nothing (the
          bindings are in src/components/CommandPalette.astro). The accelerator is bound in that
          same file but is not written on the control: the closed trigger is a search box, and the
          badge only repeated what the palette's own empty state already says.

          The label is `zinc-700` on `zinc-200` rather than the `zinc-500` on `zinc-100` it used
          to be: at 14px that pair read 4.4:1, just under the 4.5:1 floor, and the two greys were
          close enough that the closed control looked disabled next to the nav links
          (tests/unit/search-trigger.test.ts holds both ends of that).

          The chip is content-sized until xl and then keeps a floor of 11rem, which is the first
          place the row has spare width for it (measured: 227px free with the Finnish labels at
          1280, 91px at 1024, and none at 768, where the row already wraps). The floor is what
          makes the box the same width in both languages - `Haku` is a shorter word than `Search`
          - and it leaves the widening out of the layouts that have no room for it.
        -->
        <button
          type="button"
          data-search-trigger
          class="flex items-center gap-2 xl:min-w-44 px-3 py-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white bg-zinc-200 dark:bg-night-line rounded-lg border border-zinc-300 dark:border-night-line-strong transition-colors"
          aria-label={t('Search')}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <span>{t('Search')}</span>
        </button>

        <!-- Theme Toggle -->
        <button id="theme-toggle" data-theme-toggle type="button" class="p-2 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-night-raise focus:outline-none focus:ring-2 focus:ring-primary-500 rounded-lg text-sm transition-colors" aria-label="Toggle theme">
          <svg data-theme-dark-icon class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg data-theme-light-icon class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>
      </div>

      <!-- Mobile menu button & Theme toggle -->
      <div class="md:hidden flex items-center gap-2">
        <!--
          The narrow layout has no room for the label, so this is the same control as an icon. It
          carries the weight the menu button beside it carries, rather than the lighter grey it
          used to: one control should not be two colours between the two layouts.
        -->
        <button type="button" data-search-trigger aria-label={t('Search')} class="p-2 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-night-raise focus:outline-none rounded-lg text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </button>

        <button id="mobile-theme-toggle" data-theme-toggle type="button" class="p-2 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-night-raise focus:outline-none rounded-lg text-sm" aria-label="Toggle theme">
          <svg data-theme-dark-icon class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg data-theme-light-icon class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>
        
        <button id="mobile-menu-btn" class="p-2 rounded-md text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-night-raise focus:outline-none">
          <span class="sr-only">{t('Open main menu')}</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-200 dark:border-night-line bg-white dark:bg-night-card">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      {NAV_LINKS.map(link => (
        <a href={resolvePath(link.href)} aria-current={currentMarker(link.href)} class="block px-3 py-2 rounded-md text-base font-medium text-zinc-700 dark:text-zinc-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-zinc-50 dark:hover:bg-night-raise">
          {t(link.label)}
        </a>
      ))}
    </div>

    <!--
      The picker in the nav bar is hidden on a small screen, so the languages are
      offered here as well instead of being out of reach on a phone.
    -->
    <div class="border-t border-zinc-200 px-2 pt-2 pb-3 sm:px-3 dark:border-night-line">
      <p class="px-3 text-xs font-bold text-zinc-500 dark:text-zinc-400 uppercase">{t('Language')}</p>
      <LanguagePicker variant="menu" />
    </div>
  </div>
</header>

<script>
  // Must match THEME_KEY in the theme script in BaseLayout.astro.
  const THEME_KEY = 'hypernova-theme';

  function setupTheme() {
    const storedTheme = localStorage.getItem(THEME_KEY);
    if (storedTheme === 'dark' || storedTheme === 'light') {
      document.documentElement.classList.toggle('dark', storedTheme === 'dark');
    }

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', String(isDark));
        button.querySelector('[data-theme-dark-icon]')?.classList.toggle('hidden', isDark);
        button.querySelector('[data-theme-light-icon]')?.classList.toggle('hidden', !isDark);
      });
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem(THEME_KEY, isDark ? 'dark' : 'light');
      updateIcons();
    }

    updateIcons();

    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.themeBound === 'true') return;
      button.dataset.themeBound = 'true';
      button.addEventListener('click', toggleTheme);
    });
  }

  function setupMobileMenu() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuBtn && mobileMenu) {
      // Use a fresh button to avoid multiple listeners
      const newBtn = mobileMenuBtn.cloneNode(true);
      mobileMenuBtn.parentNode?.replaceChild(newBtn, mobileMenuBtn);

      newBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });

      // The menu is a panel of the sticky header that covers the top of the page, so a tap
      // that is not asking to stay puts it away again: anywhere beside the menu, and any of
      // its own links. The button toggles, so its own taps belong to the handler above, and
      // a tap on the menu's caption or its padding is still the visitor reading the menu.
      if (!window.__zenixMobileMenuOutsideBound) {
        window.__zenixMobileMenuOutsideBound = true;

        // Bound to the document, not the menu, because every navigation renders a new
        // header: the elements are looked up again for each tap.
        document.addEventListener('click', (event) => {
          const menu = document.getElementById('mobile-menu');
          const button = document.getElementById('mobile-menu-btn');
          const target = event.target;

          if (!menu || menu.classList.contains('hidden')) return;
          if (!(target instanceof Element)) return;
          if (button?.contains(target)) return;
          if (menu.contains(target) && !target.closest('a')) return;

          menu.classList.add('hidden');
        });
      }
    }
  }

  // Run on initial load
  setupTheme();
  setupMobileMenu();
  
  // Run on View Transitions page changes
  document.addEventListener('astro:page-load', () => {
    setupTheme();
    setupMobileMenu();
  });
</script>
