---
import { useTranslations } from '../i18n/utils';
const i18n = {
  fi: {
      'Why': 'Miksi',
      'open source?': 'avoin lähdekoodi?',
      'Open source gives you control: you can inspect the code, change vendors freely and keep using the systems you already have.': 'Avoin lähdekoodi antaa sinulle hallinnan: voit tarkastaa koodin, vaihtaa toimittajaa vapaasti ja jatkaa tuttujen järjestelmien käyttöä.',
      'No vendor lock-ins': 'Ei toimittajaloukkuja',
      'Change vendors without changing the software. No licence fees that rise every year, and no vendor can retire a working system to force an upgrade.': 'Vaihda toimittajaa vaihtamatta järjestelmää. Ei vuosittain nousevia lisenssimaksuja - eikä kukaan voi lopettaa toimivaa järjestelmää pakottaakseen sinut päivitykseen.',
      'Auditable by design': 'Tarkastettava koodi',
      'The code is the definitive answer to what a system does with your data. You are free to audit it at any time, at no cost.': 'Koodi on tarkin vastaus siihen, mitä järjestelmä tekee tiedoillasi. Voit tarkastaa sen milloin tahansa ja ilman kustannuksia.',
      'Cost-effective': 'Kustannustehokkuus',
      'Open development builds features, fixes and translations once and shares them with everyone, so no one pays to solve the same problem twice.': 'Avoin kehitys tekee ominaisuudet, korjaukset ja käännökset kerran ja jakaa ne kaikille, joten kukaan ei maksa saman ongelman ratkaisemisesta kahdesti.'
  }
};
const t = useTranslations(i18n, Astro);
---

<section id="whyfoss" class="py-32 bg-zinc-50 dark:bg-night-soft border-y border-zinc-200 dark:border-night-line relative overflow-hidden">
  <!-- Subtle dark background glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-zinc-200/50 via-transparent to-transparent dark:from-primary-900/10 dark:via-transparent dark:to-transparent"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
        {t('Why')} <span class="text-zinc-400 dark:text-zinc-400">{t('open source?')}</span>
      </h2>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 font-sans">
        {t('Open source gives you control: you can inspect the code, change vendors freely and keep using the systems you already have.')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
      
      <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll relative overflow-hidden group">
        <div class="w-12 h-12 bg-red-100 dark:bg-red-950 text-orange-600 dark:text-orange-300 rounded-2xl flex items-center justify-center mb-6" set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 512 512" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
	<g>
		<path d="M409.6,204.8h-256V128c0-56.559,45.841-102.4,102.4-102.4S358.4,71.441,358.4,128H384C384,57.421,326.579,0,256,0    S128,57.421,128,128v76.8h-25.6c-14.14,0-25.6,11.46-25.6,25.6v256c0,14.14,11.46,25.6,25.6,25.6h307.2    c14.14,0,25.6-11.46,25.6-25.6v-256C435.2,216.26,423.74,204.8,409.6,204.8z M409.6,486.4H102.4v-256h307.2V486.4z"/>
	</g>
	<g>
		<path d="M256,307.2c-21.171,0-38.4,17.229-38.4,38.4c0,16.666,10.735,30.737,25.6,36.045V422.4h25.6v-40.755    c14.865-5.299,25.6-19.379,25.6-36.045C294.4,324.429,277.171,307.2,256,307.2z M256,358.4c-7.066,0-12.8-5.734-12.8-12.8    c0-7.066,5.734-12.8,12.8-12.8c7.066,0,12.8,5.734,12.8,12.8C268.8,352.666,263.066,358.4,256,358.4z"/>
	</g>
</svg>`} />
        <div class="absolute inset-0 bg-gradient-to-br from-primary-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="text-3xl font-heading font-bold text-zinc-900 dark:text-white mb-4 z-10">{t('No vendor lock-ins')}</h3>
        <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
          {t('Change vendors without changing the software. No licence fees that rise every year, and no vendor can retire a working system to force an upgrade.')}
        </p>
      </div>

      <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll" style="transition-delay: 200ms;">
        <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 text-accent-600 dark:text-zinc-400  rounded-2xl flex items-center justify-center mb-6" set:html={`        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>`} />
        <h3 class="text-3xl font-heading font-bold text-zinc-900 dark:text-white mb-4 z-10">{t('Auditable by design')}</h3>
        <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
          {t('The code is the definitive answer to what a system does with your data. You are free to audit it at any time, at no cost.')}
        </p>
      </div>

      <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll" style="transition-delay: 100ms;">
        <div class="w-12 h-12 bg-accent-100 dark:bg-night-raise text-accent-600 dark:text-green-600 rounded-2xl flex items-center justify-center mb-6" set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="54px" height="54px" viewBox="-9 0 32 32" fill="currentColor" stroke="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M11.040 20.96c-0.6 0.24-1.2 0.32-1.84 0.32-2.12 0-3.92-1.24-4.76-3h4.72c0.48 0 0.84-0.4 0.84-0.84s-0.4-0.84-0.84-0.84h-5.24c-0.040-0.2-0.040-0.4-0.040-0.6s0-0.4 0.040-0.6h5.24c0.48 0 0.84-0.4 0.84-0.84s-0.4-0.84-0.84-0.84h-4.76c0.88-1.76 2.68-3 4.76-3 0.6 0 1.24 0.12 1.84 0.32 0.44 0.16 0.92-0.080 1.080-0.52s-0.080-0.92-0.52-1.080c-0.8-0.28-1.6-0.44-2.44-0.44-3.080 0-5.68 1.96-6.6 4.72h-1.68c-0.48 0-0.84 0.4-0.84 0.84s0.4 0.84 0.84 0.84h1.36c0 0.2-0.040 0.4-0.040 0.6s0 0.4 0.040 0.6h-1.36c-0.48 0-0.84 0.4-0.84 0.84s0.4 0.84 0.84 0.84h1.72c0.96 2.72 3.56 4.72 6.6 4.72 0.84 0 1.64-0.16 2.44-0.44 0.44-0.16 0.68-0.64 0.52-1.080s-0.64-0.68-1.080-0.52z"></path></svg>`} />
        <h3 class="text-3xl font-heading font-bold text-zinc-900 dark:text-white mb-4 z-10">{t('Cost-effective')}</h3>
        <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
          {t('Open development builds features, fixes and translations once and shares them with everyone, so no one pays to solve the same problem twice.')}
        </p>
      </div>
    </div>
  </div>
</section>
