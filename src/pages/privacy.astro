---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/LegalDocument.astro';
import { privacyPolicy } from '../legal/privacy-policy';
import { isLanguage, type Language } from '../i18n/ui';

const lang: Language = isLanguage(Astro.locals.lang) ? Astro.locals.lang : 'gb';
---

<BaseLayout title={privacyPolicy.title[lang]} description={privacyPolicy.description[lang]}>
  <LegalDocument document={privacyPolicy} />
</BaseLayout>
