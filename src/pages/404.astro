---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { resolvePath } from '../utils/navigation';
import { useTranslations } from '../i18n/utils';

const i18n = {
  fi: {
    'Page Not Found': 'Sivua ei löytynyt',
    'The page you are looking for does not exist.': 'Etsimääsi sivua ei ole olemassa.',
    'Page not found': 'Sivua ei löytynyt',
    "Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.":
      'Valitettavasti emme löytäneet etsimääsi sivua. Se on saatettu siirtää tai poistaa.',
    'Back to the home page': 'Takaisin etusivulle',
  }
};
const t = useTranslations(i18n, Astro);
---

<BaseLayout title={t('Page Not Found')} description={t('The page you are looking for does not exist.')}>
  <div class="py-24 md:py-32 flex-grow flex items-center justify-center">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-2xl">
      <div class="text-primary-600 font-bold text-7xl md:text-9xl mb-6">404</div>
      <h1 class="text-3xl md:text-4xl font-bold text-zinc-900 dark:text-white mb-4">{t('Page not found')}</h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 mb-10">
        {t("Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.")}
      </p>
      <div class="flex justify-center gap-4">
        <Button href={resolvePath('/')} variant="primary" size="lg">{t('Back to the home page')}</Button>
      </div>
    </div>
  </div>
</BaseLayout>
