---
import Badge from '../components/Badge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import KohaScreenshot from '../components/KohaScreenshot.astro';
import KohaServiceComponent from '../components/KohaService.astro';

import { Image } from 'astro:assets';
import kohaLogo from "../images/koha.webp";
import FormValidation from '../components/FormValidation.astro';
import { useTranslations } from '../i18n/utils';
import {
  checkFormToken,
  cleanValues,
  clientId,
  createFormToken,
  detectSpam,
  isRateLimited,
  safeClientAddress,
  MAX_MESSAGE_LENGTH,
  MAX_SHORT_FIELD_LENGTH,
} from '../utils/form-protection';

export const prerender = false;

const i18n = {
  fi: {
    'Koha Library System': 'Koha-kirjastojärjestelmä',
    'Open source library system': 'Avoimen koodin kirjastojärjestelmä',
    'Koha is the first Free and Open Source library system in the world, and it has been the pioneer of secure and sustainable catalog and patron management since 1999. Discover the': 'Koha on maailman ensimmäinen vapaan ja avoimen lähdekoodin kirjastojärjestelmä. Se on toiminut edelläkävijänä kirjaston kestävässä ja turvallisessa aineisto- ja asiakastietokannan hallinnoimisessa jo vuodesta 1999 alkaen. Tutustu tarkemmin',
    'benefits of free and open source software': 'vapaan ja avoimen lähdekoodin hyötyihin',
    'For libraries of any size': 'Kaikenkokoisille kirjastoille',
    'Koha is a full-featured, scalable library management system, funded by libraries of all types and sizes, by volunteers and by support companies worldwide.': 'Koha soveltuu sekä pienille erikoiskirjastoille että suuremmille yleisille ja akateemisille kirjastoille. Kohaan sisältyvät käytännössä kaikki toiminnallisuudet, joita kirjasto tarvitsee. Järjestelmän kehitystä rahoittavat kirjastot, vapaaehtoiset ja tukiyritykset ympäri maailmaa.',
    'Customizable': 'Mukautuu tarpeisiinne',
    'Koha can be configured in hundreds of ways, which makes it suitable for any type of library. It also supports many open standards and integrates with countless other systems.': 'Koha on erittäin mukautuva järjestelmä. Se sisältää satoja asetuksia, joiden ansiosta Kohan voi konfiguroida palvelemaan minkä tyyppistä kirjastoa tahansa. Koha tukee useita avoimia standardeja, ja sen voi integroida lukemattomiin muihin järjestelmiin, mukaan lukien Finna, Finto ja Melinda. Koska Koha on vapaata koodia, kuka tahansa voi laajentaa ja jatkokehittää sitä.',
    'Koha Cloud Hosting Service': 'Koha-pilvipalvelu',
    'Try Koha for free': 'Kokeile Kohaa ilmaiseksi',
    'Sustainable choice': 'Kestävä valinta',
    'Koha is a library system that has been in active development since 1999. Backed by thousands of libraries around the world, its community keeps Koha in step with modern standards and technologies. Koha has a responsive interface that works on desktops, tablets and phones, and it connects to other systems through a range of APIs.': 'Koha on pitkäikäinen kirjastojärjestelmä, joka on ollut aktiivisessa kehityksessä vuodesta 1999 alkaen. Kohan takana on maailmanlaajuisesti tuhansia kirjastoja, joiden muodostama yhteisö pitää huolen siitä, että Koha on tietoturvallinen ja tukee moderneja standardeja ja teknologioita. Kohassa on responsiivinen käyttöliittymä, joka soveltuu kaikentyyppisille laitteille, kuten tietokoneille, matkapuhelimille ja lainausautomaateille. Kohan voi yhdistää muihin järjestelmiin lukuisten rajapintojen avulla.',
    'One of the main strengths of Koha is that nobody "owns" its source code. The GPLv3 licence gives everyone the right to copy and modify the software. Unlike proprietary systems, no vendor can decide that Koha is finished and push a library to buy a new system. Anyone can take a copy of Koha at any time and continue its development. Koha lives as long as its community keeps it going. And there is no sign of that slowing down. That is why we often say Koha will probably be the last library system your library will ever need.': 
    'Yksi Kohan suurimmista vahvuuksista on se, ettei kukaan "omista" sen lähdekoodia. GPLv3-lisenssi antaa jokaiselle oikeuden kopioida ja muokata sitä. Toisin kuin kaupallisissa järjestelmissä, mikään taho ei voi päättää, että Kohan kehitys päättyy, ja pakottaa näin kirjaston hankkimaan tilalleen uuden järjestelmän. Kuka tahansa voi milloin tahansa ottaa Kohasta uuden kopion ja jatkaa sen kehitystä. Koha elää niin kauan kuin sen yhteisö sitä tukee, eikä hiipumisen merkkejä ole näkyvissä - päinvastoin, Kohan yhteisö on varsin aktiivinen ja kasvaa jatkuvasti. Tästä syystä meillä on tapana sanoa, että Koha tulee todennäköisesti olemaan viimeinen kirjastojärjestelmä, jonka kirjastosi tarvitsee.',
    'Request': 'Pyydä',
    'a quote': 'tarjous',
    'Free your library from vendor lock-ins and offer a transparent, sustainable service to your patrons. Koha will probably be the last library system your library ever needs.': 'Vältä toimittajaloukut ja tarjoa asiakkaille läpinäkyvää ja kestävää kirjastopalvelua. Koha on todennäköisesti viimeinen kirjastojärjestelmä, jonka kirjastosi tarvitsee.',
    'Thank you for submitting your request.': 'Kiitos tarjouspyynnön lähettämisestä.',
    'We will reply to the e-mail address you provided.': 'Olemme yhteydessä antamaasi sähköpostiosoitteeseen.',
    'Unfortunately an error occurred. Please try again later or contact us by post (our address is on the contact page) and include the following error message.':
      'Valitettavasti lomakkeen lähetys epäonnistui. Yritä myöhemmin uudelleen tai ota yhteyttä postitse (osoitteemme on yhteystiedot-sivulla) ja liitä mukaan seuraava virheviesti.',
    'Too many submissions from this connection. Please try again later or contact us by post (our address is on the contact page).':
      'Tältä yhteydeltä on tullut liian monta lähetystä. Yritä myöhemmin uudelleen tai ota yhteyttä postitse (osoitteemme on yhteystiedot-sivulla).',
    'Contact information': 'Yhteystiedot',
    'Name': 'Nimi',
    'Organization': 'Organisaatio',
    'E-mail': 'Sähköposti',
    'Catalog and user details': 'Kokoelma- ja asiakastiedot',
    'Please enter the number of': 'Syötä lukumäärä',
    'Records': 'Nimekkeet',
    'Items': 'Niteet',
    'Annual circulation': 'Vuosittainen lainamäärä',
    'Patrons': 'Asiakkaat',
    'Librarians': 'Virkailijat',
    'Current library system': 'Nykyinen kirjastojärjestelmä',
    'Current system': 'Nykyinen järjestelmä',
    'Your library': 'Kirjastosi',
    'Describe your library and its daily work. Do not worry about being too formal. Tell us what kind of material your library manages, what types of patrons you serve, what circulation rules you use, what your library building is like and how it affects your shelving locations, and so on.': 
    'Kuvaile kirjastosi arkea. Vastauksen ei tarvitse olla muodollinen. Kerro, millaista aineistoa kirjastosi hallinnoi, millaisia asiakkaita kirjastosi palvelee, millaisia lainaussääntöjä kirjastossasi on, millaisia fyysisiä ominaisuuksia kirjastorakennuksellasi on (esim. onko useita toimipisteitä) ja miten ne vaikuttaa hyllypaikkoihin, jne.',
    'The more detail you give us, the better we can tailor the Koha configuration for your library.': 'Mitä tarkemmin kuvailet kirjastoasi, sitä paremmin voimme räätälöidä Koha-tarjouksen kirjastollesi.',
    'You can also skip this step.': 'Jos tuntuu ettei nyt ehdi tai jaksa runoilla, niin jätä kenttä tyhjäksi. Me laitetaan kyllä tarjous hyvin matalalla kynnykselläkin.',
    'Additional services and integrations': 'Muut palvelut ja integraatiot',
    'Do you have checkout machines that need to be connected to Koha? Does your library system talk to other systems - for example SSO authentication (Azure/Google/other), mail servers (O365/Gmail/other) for library notifications, or online resources behind authentication?': 
    'Onko teillä lainausautomaatteja, jotka pitää kytkeä Kohaan? Keskusteleeko kirjastojärjestelmäsi muiden järjestelmien kanssa - esimerkiksi SSO-tunnistautuminen (Azure/Google/muu), sähköpostipalvelimet (O365/Gmail/muu) kirjaston asiakasilmoituksiin tai tunnistautumisen takana olevat verkkoaineistot?',
    'It is perfectly normal not to need any additional services or integrations, so it is fine to leave this field empty. Koha can for example send notifications without O356/Gmail integration as well.': 'On täysin normaalia, ettei ylimääräisiä palveluita tai integraatioita tarvita, joten kentän voi hyvin jättää tyhjäksi. Koha osaa esimerkiksi lähettää sähköpostia ilman O365/Gmail-integraatiotakin.',
    'We ask because integrations take a little more work to set up and sometimes require software development.': 'Kysymme siksi, että integraatioiden asentaminen ja määrittely vaatii hieman enemmän työtä ja tarvittaessa ohjelmistokehitystäkin.',
    'Ready?': 'Valmista?',
    'Submit': 'Lähetä tarjouspyyntö',
    'Please enter your name. ': 'Syötä nimesi. ',
    'Please enter an email address. ': 'Syötä sähköpostiosoitteesi. ',
    'Please enter your organization. ': 'Syötä organisaatiosi. '
  }
};
const t = useTranslations(i18n, Astro);

const formId = 'koha' as const;
const errors = { name: "", email: "", organization: "", form: "" };
let formSent = false;
let rateLimited = false;
let description = "";
const formData = {
    name: "",
    organization: "",
    email: "",
    website: "",
    records: "",
    items: "",
    circulation: "",
    patrons: "",
    librarians: "",
    current_ils: "",
    about_my_library: "",
    additional_services: ""
};

// A signed, timestamped token for this page load. It is re-used when the form is
// rendered again after a validation error, so fixing a typo quickly is not
// mistaken for an automated submission.
let formToken = createFormToken(formId);

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const raw: Record<string, string> = {};
    data.forEach(function(value, key){
      if (typeof value === "string") {
        raw[key] = value;
      }
    });
    const fields = cleanValues(raw);
    Object.keys(formData).forEach(function(key){
      if (key in fields) {
        (formData as Record<string, string>)[key] = fields[key];
      }
    });

    const name = fields.name;
    const organization = fields.organization;
    const email = fields.email;
    const bot_test = fields.website;

    if (typeof name !== "string" || name.length < 1) {
      errors.name += t("Please enter your name. ");
    }
    if (typeof organization !== "string" || organization.length < 1) {
      errors.organization += t("Please enter your organization. ");
    }
    if (typeof email !== "string" || email.length < 6 || email.search(/@/) < 0) {
      errors.email += t("Please enter an email address. ");
    }
    const hasErrors = Object.values(errors).some(msg => msg)

    const tokenReason = checkFormToken(raw.form_token, formId);
    if (tokenReason === null || tokenReason === "too-fast") {
      formToken = raw.form_token as string;
    }

    // Only submissions that pass validation are judged, so a visitor fixing a
    // mistake still gets the field messages.
    const spamReason = hasErrors
      ? null
      : detectSpam({ formId, request: Astro.request, host: Astro.url.host, raw, fields });

    if (hasErrors) {
      // Validation errors are rendered back to the visitor, nothing to log.
    } else if ((typeof bot_test === "string" && bot_test.length > 0) || spamReason) {
      // Bot signals are answered exactly like a real submission so scripts learn
      // nothing, but Redmine is never contacted. The reason is safe to log: it
      // carries no visitor data.
      console.warn("Koha quote form submission dropped:", spamReason ?? "honeypot");
      formSent = true;
    } else if (isRateLimited(clientId(Astro.request, safeClientAddress(() => Astro.clientAddress)))) {
      // The visitor is told, unlike with a bot signal: a real person may have hit
      // the limit by accident and should not lose their message silently.
      rateLimited = true;
    } else {
      Object.keys(formData).forEach(function(key){
        const value = fields[key];
        if (typeof value === "string" && value.length > 0) {
          description += "**"+key+"**: " + value + "\n";
        }
      });
      const redminePayload = {
        issue: {
          project_id: parseInt(import.meta.env.REDMINE_NEW_QUOTE_PROJECT_ID),
          status_id: parseInt(import.meta.env.REDMINE_NEW_QUOTE_STATUS_ID),
          subject: organization.length > 0 ? organization : name,
          description: description
        }
      };
      const redmineResponse = await fetch(import.meta.env.REDMINE_NEW_QUOTE_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Redmine-API-Key': import.meta.env.REDMINE_NEW_QUOTE_API_KEY
        },
        body: JSON.stringify(redminePayload)
      });
      const redmineData = await redmineResponse.json();
      formSent = true;
      if (redmineResponse.status === 201) {
        // Issue created in Redmine.
      } else {
        if ('errors' in redmineData) {
          errors.form = String(redmineResponse.status) + " " + JSON.stringify(redmineData.errors);
        } else {
          errors.form = String(redmineResponse.status);
        }
        // Log the status only - never the submitted personal data.
        console.error('Redmine quote issue creation failed with status', redmineResponse.status);
      }
    }
  } catch (error) {
    console.error('Koha quote form submission failed', error);
  }
}

