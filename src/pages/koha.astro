			C480.005,334.256,433.141,381.12,375.537,381.12z"/></g></svg>`} />
          <h3 class="text-3xl font-heading font-bold text-zinc-900 dark:text-white mb-4 z-10">{t('Easy and Reliable')}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
            {t('Access')} <a href="#what-is-koha" class="dark:text-zinc-100 hover:text-zinc-600">{t('Koha Library System')}</a> {t('using only your web browser. Our modern cloud infrastructure is monitored in real time to ensure consistent and reliable Koha user experience.')}
          </p>
        </div>
        <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll min-h-[320px] lg:min-h-0">
          <div class="w-12 h-12 bg-zinc-100 dark:bg-zinc-600 text-zinc-600 dark:text-zinc-900 rounded-2xl flex items-center justify-center mb-6" set:html={`
          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" height="24px" width="24px" fill="currentColor" stroke="currentColor" viewBox="0 0 512 512" xml:space="preserve">
<g>
	<path class="st0" d="M165.865,85.55c23.636,0,42.779-19.159,42.779-42.77C208.644,19.142,189.501,0,165.865,0   c-23.636,0-42.779,19.142-42.779,42.779C123.086,66.391,142.229,85.55,165.865,85.55z"/>
	<path class="st0" d="M222.061,97.624H109.669c-20.726,0-43.274,22.548-43.274,43.282v143.768c0,10.363,8.396,18.767,18.758,18.767   c10.363,0,18.775-8.404,18.775-18.767V166.469h8.651v320.88c0,13.616,11.035,24.651,24.644,24.651   c13.625,0,24.66-11.035,24.66-24.651V301.138h7.964v186.211c0,13.616,11.035,24.651,24.66,24.651   c13.609,0,24.644-11.035,24.644-24.651v-320.88h8.668v118.204c0,10.363,8.396,18.767,18.758,18.767   c10.379,0,18.759-8.404,18.759-18.767V140.906C265.335,120.172,242.787,97.624,222.061,97.624z"/>
	<path class="st0" d="M373.041,256.72c19.206,0,34.758-15.568,34.758-34.751c0-19.206-15.552-34.759-34.758-34.759   c-19.206,0-34.758,15.552-34.758,34.759C338.283,241.152,353.835,256.72,373.041,256.72z"/>
	<path class="st0" d="M412.989,278.117h-84.718c-15.616,0-32.616,16.992-32.616,32.624v75.482c0,7.812,6.333,14.145,14.137,14.145   c7.812,0,14.153-6.333,14.153-14.145v-56.212h6.525v163.407c0,10.267,8.316,18.582,18.566,18.582   c10.275,0,18.592-8.316,18.592-18.582v-94.785h6.005v94.785c0,10.267,8.316,18.582,18.582,18.582   c10.259,0,18.582-8.316,18.582-18.582V330.011h6.525v56.212c0,7.812,6.332,14.145,14.137,14.145   c7.828,0,14.144-6.333,14.144-14.145v-75.482C445.605,295.108,428.614,278.117,412.989,278.117z"/>
</g>
</svg>
`} />
          <div class="absolute inset-0 bg-gradient-to-br from-primary-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <h3 class="text-3xl font-heading font-bold text-zinc-900 dark:text-white mb-4 z-10">{t('Secure and Up-to-date')}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
            {t('Automatic security updates. Daily encrypted backups, stored in multiple secure locations. Feature updates twice a year. Includes encrypted network connections and SSL certificates.')}
          </p>
        </div>
  
        <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll min-h-[320px] lg:min-h-0" style="transition-delay: 100ms;">
          <div class="w-12 h-12 bg-accent-100 dark:bg-accent-900/40 text-accent-600 dark:text-green-400 rounded-2xl flex items-center justify-center mb-6" set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="54px" height="54px" viewBox="-9 0 32 32" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M11.040 20.96c-0.6 0.24-1.2 0.32-1.84 0.32-2.12 0-3.92-1.24-4.76-3h4.72c0.48 0 0.84-0.4 0.84-0.84s-0.4-0.84-0.84-0.84h-5.24c-0.040-0.2-0.040-0.4-0.040-0.6s0-0.4 0.040-0.6h5.24c0.48 0 0.84-0.4 0.84-0.84s-0.4-0.84-0.84-0.84h-4.76c0.88-1.76 2.68-3 4.76-3 0.6 0 1.24 0.12 1.84 0.32 0.44 0.16 0.92-0.080 1.080-0.52s-0.080-0.92-0.52-1.080c-0.8-0.28-1.6-0.44-2.44-0.44-3.080 0-5.68 1.96-6.6 4.72h-1.68c-0.48 0-0.84 0.4-0.84 0.84s0.4 0.84 0.84 0.84h1.36c0 0.2-0.040 0.4-0.040 0.6s0 0.4 0.040 0.6h-1.36c-0.48 0-0.84 0.4-0.84 0.84s0.4 0.84 0.84 0.84h1.72c0.96 2.72 3.56 4.72 6.6 4.72 0.84 0 1.64-0.16 2.44-0.44 0.44-0.16 0.68-0.64 0.52-1.080s-0.64-0.68-1.080-0.52z"></path></svg>`} />
          <h3 class="text-3xl font-heading font-bold text-zinc-900 dark:text-white mb-4 z-10">{t('GDPR and Data Control')}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
            {t('User data and rights are protected by GDPR. You as the data controller have the full control and free (both freedom and free of charge) access to your database. SSH remote access included.')}
          </p>
        </div>
    </div>
    <Button href="#request-a-quote" variant="primary" size="lg" class="w-full mt-12 sm:w-auto text-lg px-8 py-4 shadow-xl shadow-primary-500/20">
      {t('Request a Quote')}
    </Button>
    <div class="p-8 max-w-3xl mx-auto py-32 reveal-on-scroll">
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
        {t('With Leading Experience')}
      </h2>
      <p class="text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
        {t('Our Koha professionals have more than a decade of Koha experience from libraries of various sizes. We have hosted and supported large consortiums, academic libaries, school libraries and smaller special libraries each with their own unique ways to operate a library. Over the years we have contributed thousands of software changes, features and translations to Koha. Our team has developed countless integrations to other systems using open standards and APIs, making Koha more modern and accessible to rest of the world.')}
      </p>
      <p class="mt-5 text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
        {t('Our clients range from large state organizations to the smallest village libraries and anything in between. Hypernova has collaborated with')} <a href="https://www.kansalliskirjasto.fi" target="_blank">{t('the National Library of Finland')}</a> {t('and various other private Koha organizations around the world.')} 
      </p>
      <p class="mt-5 text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
        {t('This vast experience has enhanced our problem solving skills and provided us the ability to use innovative methods to optimize your library operations.')}
      </p>
    </div>
  </div>
</section>
<section id="request-a-quote" class="py-32 bg-zinc-50 dark:bg-[#0c0c0f] border-y border-zinc-200 dark:border-zinc-800 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-zinc-200/50 via-transparent to-transparent dark:from-primary-900/10 dark:via-transparent dark:to-transparent"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
        {t('Request')} <span class="text-zinc-400 dark:text-zinc-500">{t('a quote')}</span>
      </h2>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 font-sans">
        {t('Free your library from vendor lock-ins and provide a transparent and sustainable service to your visitors. Koha will likely be the last library system you will ever need.')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-1 lg:grid-rows-[minmax(260px,auto)_minmax(280px,auto)] gap-6 max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto py-12 reveal-on-scroll" style={formSent ? '' : 'display:none'}>
        <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
          {t('Thank you for submitting your request.')}
        </h2>
        <p style={errors.form ? 'display:none' : ''} class="text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
          {t('We will be in contact to the email address you provided.')}
        </p>
        <p style={errors.form ? '' : 'display:none'}class="text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
          {t('Unfortunately an error occurred. Please contact us at')} <a href="mailto:contact@hypernova.fi">contact@hypernova.fi</a> {t('and provide the following error message.')}

          <div style={errors.form ? '' : 'display:none'} class="mt-10 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-3xl p-8 flex flex-col relative transform shadow-2xl shadow-primary-500/10 reveal-on-scroll" style="transition-delay: 100ms;">
            {errors.form}
          </div>
        </p>
      </div>
      <form method="POST" action="#request-a-quote" style={formSent && errors.form.length === 0 ? 'display:none': ''} >
        <div class="glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-3xl p-8 flex flex-col relative transform shadow-2xl shadow-primary-500/10 reveal-on-scroll" style="transition-delay: 100ms;">
          <div class="grid md:grid-cols-4 sm:grid-cols-1 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Contact information')}</Badge> 
            </div>
            <label class="p-3 mt-5 col-span-1">{t('Name')}</label><input type="text" name="name" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.name} required /><div class="md:col-span-2"></div>
            {errors.name && <p class="col-span-1 md:col-span-4 text-red-800">{errors.name}</p>}
            <label class="p-3 mt-5 col-span-1">{t('Organization')}</label><input type="text" name="organization" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.organization} required /><div class="md:col-span-2"></div>
            {errors.organization && <p class="col-span-1 md:col-span-4 text-red-800">{errors.organization}</p>}
            <label class="p-3 mt-5 col-span-1">{t('E-mail')}</label><input type="email" name="email" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.email} required /><div class="md:col-span-2"></div>
            <span class="hidden"><input type="text" name="website" value={formData.website} /></span>
            {errors.email && <p class="col-span-1 md:col-span-4 text-red-800">{errors.email}</p>}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-4 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Catalog and user details')}</Badge> 
            </div>
            <h3 class="col-span-1 md:col-span-4">{t('Please enter the number of')}</h3>
            <label class="p-3 mt-5 col-span-1">{t('Records')}</label><input type="text" name="records" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.records} /><div class="md:col-span-2"></div>
            <label class="p-3 mt-5 col-span-1">{t('Items')}</label><input type="text" name="items" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.items} /><div class="md:col-span-2"></div>
            <label class="p-3 mt-5 col-span-1">{t('Annual circulation')}</label><input type="text" name="circulation" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.circulation} /><div class="md:col-span-2"></div>
            <label class="p-3 mt-5 col-span-1">{t('Patrons')}</label><input type="text" name="patrons" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.patrons} /><div class="md:col-span-2"></div>
            <label class="p-3 mt-5 col-span-1">{t('Librarians')}</label><input type="text" name="librarians" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1"  value={formData.librarians} /><div class="md:col-span-2"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-4 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Current system<')}</Badge> 
            </div>
            <label class="p-3 mt-5 col-span-1">{t('Current library system')}</label><input type="text" name="current_ils" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.records} /><div class="md:col-span-2"></div>
        </div>
          <div class="grid grid-cols-2 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Your library')}</Badge> 
            </div>
            <p class="col-span-2 mb-3">{t('Describe your library and its daily operations. Do not worry about being too formal. Tell us what kind of material your library manages, what type of patrons are registered at your library, what kind of circulation rules apply, physical characterestics of your library building and how it affects your shelving locations, etc.')}</p>
            <p class="col-span-2 mb-3">{t('The more detailed description you provide the better we will be able to optimize a suitable Koha configuration for your library.')}</p>
            <textarea name="about_my_library" rows="5" class="p-3 sm:col-span-1 col-span-2 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1">{formData.about_my_library}</textarea>
          </div>
          <div class="grid grid-cols-2 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Additional services and integrations')}</Badge> 
            </div>
            <p class="col-span-2 mt-10 lg:mt-3 mb-3">{t('Do you have checkout machines that need to be connected to Koha? Does your library system talk to other systems, for example SSO authentication (Azure/Google/other), email servers (O365/Gmail/other) for sending library notifications, online resources behind authentication and so on.')}</p>
            <p class="col-span-2 mb-3">{t('It is perfectly normal not to need any additional services or integrations, so is okay to leave the following field empty.')}</p>
            <p class="col-span-2 mb-3">{t('We ask because configuring integrations requires slightly more work and in some cases may require software development.')}</p>

            <textarea name="additional_services" rows="5" class="p-3 sm:col-span-1 col-span-2 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1">{formData.additional_services}</textarea>
          </div>
          <div class="grid grid-cols-2 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Ready?')}</Badge> 
            </div>
            <Button type="submit" class="border-2 col-span-2 border-primary-500">{t('Submit')}</Button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>
</div>

</BaseLayout>
