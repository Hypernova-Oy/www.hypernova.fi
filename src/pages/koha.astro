---
import Badge from '../components/Badge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

import { Image } from 'astro:assets';
import kohaLogo from "../images/koha.webp";
import { useTranslations } from '../i18n/utils';

export const prerender = false;

const errors = { name: "", email: "", organization: "", form: "" };
let formSent = false;
let description = "";
const formData = {
    name: "",
    organization: "",
    email: "",
    website: "",
    records: "",
    items: "",
    circulation: "",
    patrons: "",
    librarians: "",
    current_ils: "",
    about_my_library: "",
    additional_services: ""
};

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    data.forEach(function(value, key){
      if (typeof value === "string" && key in formData) {
        formData[key] = value;
      }
    });
    const name = data.get("name");
    const organization = data.get("organization");
    const email = data.get("email");
    const bot_test = data.get("website");
    const records = data.get("records");
    const items = data.get("items");
    const circulation = data.get("circulation");
    const patrons = data.get("patrons");
    const librarians = data.get("librarians");
    const current_ils = data.get("current_ils");
    const about_my_library = data.get("about_my_library");
    const additional_services = data.get("additional_services");

    if (typeof name !== "string" || name.length < 1) {
      errors.name += t("Please enter your name. ");
    }
    if (typeof organization !== "string" || organization.length < 1) {
      errors.name += t("Please enter your organization. ");
    }
    if (typeof email !== "string" || email.length < 6 || email.search(/@/) < 0) {
      errors.email += t("Please enter an email address. ");
    }
    const hasErrors = Object.values(errors).some(msg => msg)
    if (typeof bot_test === "string" && bot_test.length>0) {
      console.error("Bot detected. " + JSON.stringify(formData));
      formSent = true;
    } else if (!hasErrors) {
      Object.keys(formData).forEach(function(key){
        let value = formData[key];
        if (typeof value !== null && value.length > 0) {
          description += "**"+key+"**: " + value + "\n";
        }
      });
      const redminePayload = {
        issue: {
          project_id: parseInt(import.meta.env.REDMINE_NEW_QUOTE_PROJECT_ID),
          status_id: parseInt(import.meta.env.REDMINE_NEW_QUOTE_STATUS_ID),
          subject: typeof organization === "string" && organization.length > 0 ? organization : name,
          description: description
        }
      };
      console.error(redminePayload);
      const redmineResponse = await fetch(import.meta.env.REDMINE_NEW_QUOTE_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Redmine-API-Key': import.meta.env.REDMINE_NEW_QUOTE_API_KEY
        },
        body: JSON.stringify(redminePayload)
      });
      const redmineData = await redmineResponse.json();
      formSent = true;
      if (redmineResponse.status === 201) {
        
      } else {
        if ('errors' in redmineData) {
          errors.form = String(redmineResponse.status) + " " + JSON.stringify(redmineData.errors);
        } else {
          errors.form = String(redmineResponse.status);
        }
        console.error(redmineResponse);
        console.error(redmineData);
      }
    } else {
      console.error(errors);
    }
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}

const i18n = {
