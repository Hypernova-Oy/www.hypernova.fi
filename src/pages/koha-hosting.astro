---
import BaseLayout from '../layouts/BaseLayout.astro';
import KohaServiceComponent from '../components/KohaService.astro';
import { resolvePath } from '../utils/navigation';

import { Image } from 'astro:assets';
import kohaLogo from "../images/koha.webp";

import { useTranslations } from '../i18n/utils';

/*
 * The service has one name in Finnish, and the page takes the one the rest of the site
 * already uses for it: the navbar's 'Koha Cloud Hosting' and the call to action on /koha/
 * both read `Koha-pilvipalvelu` (src/pages/koha.astro). A second spelling here would be the
 * name of the same service saying two things.
 */
const i18n = {
  fi: {
      'Koha Cloud Hosting Service': 'Koha-pilvipalvelu',
      'Koha Library System Cloud Hosting Service': 'Koha-kirjastojärjestelmän pilvipalvelu',
  }
};
const t = useTranslations(i18n, Astro);

export const prerender = false;
---

<BaseLayout title={t('Koha Cloud Hosting Service')} description={t('Koha Library System Cloud Hosting Service')}>
  <div class="bg-zinc-50 dark:bg-night-soft border-b border-zinc-200 dark:border-night-line py-16 md:py-24 transition-colors">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-4">{t('Koha Cloud Hosting Service')}</h1>
      
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-8 max-w-6xl mx-auto mt-10">
        <div></div>
        <div><a href={resolvePath('/koha/')} target="_blank"><Image src={kohaLogo} alt="Koha" widths={[224, 448, 768]} sizes="(min-width: 768px) 768px, 224px" loading="lazy" decoding="async" class="mx-auto w-56 md:w-auto" /></a></div>
        <div></div>
      </div>
    </div>

    <KohaServiceComponent showScreenshot />
  </div>

  
  
</BaseLayout>
