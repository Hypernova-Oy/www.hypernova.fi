---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesComponent from '../components/Services.astro';
import { useTranslations } from '../i18n/utils';
const i18n = {
  fi: {
      'Koha, Lainuri and Toveri services': 'Koha-, Lainuri- ja Toveri-palvelut',
      // The sentence a search engine shows under the title, not the label the page carries.
      'Koha hosting, the Lainuri checkout machine and the Toveri access control device: what we deliver to libraries, and what is included.': 'Kohan pilvipalvelu, Lainuri-lainausautomaatti ja Toveri-kulunvalvontalaite: mitä toimitamme kirjastoille ja mitä kokonaisuuteen kuuluu.',
      'Services': 'Palvelut',
      'Our Services': 'Palvelumme',
      'Choose the open source solution that fits your organisation.': 'Valitse teille sopiva avoimen lähdekoodin ratkaisu.'
  }
};
const t = useTranslations(i18n, Astro);
---

<BaseLayout
  title={t('Koha, Lainuri and Toveri services')}
  description={t('Koha hosting, the Lainuri checkout machine and the Toveri access control device: what we deliver to libraries, and what is included.')}
  breadcrumb={t('Our Services')}
>
  <div class="bg-zinc-50 dark:bg-night-soft border-b border-zinc-200 dark:border-night-line py-16 md:py-24 transition-colors">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-4">{t('Our Services')}</h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400">
        {t('Choose the open source solution that fits your organisation.')}
      </p>
    </div>
  </div>

  <ServicesComponent />
  
</BaseLayout>
