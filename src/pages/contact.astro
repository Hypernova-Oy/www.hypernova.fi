---
import Badge from '../components/Badge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

import { Image } from 'astro:assets';
import kohaLogo from "../images/koha.webp";
import { useTranslations } from '../i18n/utils';

export const prerender = false;

const i18n = {
  fi: {
    'Contact': 'Yhteystiedot',
    'Contact us': 'Ota yhteyttä',
    'VAT ID': 'Y-tunnus',
    'FI29256763': '2925676-3',
    'Our postal address is': 'Postiosoitteemme on',
    'FINLAND': 'SUOMI',
    'PO box': 'PL',
    'Billing information': 'Laskutustiedot',
    'E-invoice number / EDI code': 'Verkkolaskuosoite/OVT-tunnus',
    'E-invoice operator': 'Verkkolaskuoperaattori',
    'Contact information': 'Yhteystiedot',
    'Name': 'Nimi',
    'Organization': 'Organisaatio',
    'E-mail': 'Sähköposti',
    'How can we help you?': 'Miten voimme auttaa?',
    'Ready?': 'Valmista?',
    'Submit': 'Lähetä yhteydenottopyyntö',
    'Please enter your name. ': 'Syötä nimesi. ',
    'Please enter an email address. ': 'Syötä sähköpostiosoitteesi. ',
    'Thank you for submitting your request.': 'Kiitos yhteydenotostasi.',
    'We will be in contact to the email address you provided.': 'Olemme teihin yhteydessä pikimmiten.',
    'Unfortunately an error occurred. Please contact us at': 'Valitettavasti lomakkeen lähetys epäonnistui. Ota yhteyttä osoitteeseen',
    'and provide the following error message.': 'ja liitä seuraava virheviesti.',
  }
} as i18n;
const t = useTranslations(i18n);

const errors = { name: "", email: "", organization: "", form: "" };
let formSent = false;
let description = "";
const formData = {
    name: "",
    organization: "",
    email: "",
    website: "",
    content: "",
};

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    data.forEach(function(value, key){
      if (typeof value === "string" && key in formData) {
        formData[key] = value;
      }
    });
    const name = data.get("name");
    const organization = data.get("organization");
    const email = data.get("email");
    const bot_test = data.get("website");
    const content = data.get("content");

    if (typeof name !== "string" || name.length < 1) {
      errors.name += t("Please enter your name. ");
    }
    if (typeof email !== "string" || email.length < 6 || email.search(/@/) < 0) {
      errors.email += t("Please enter an email address. ");
    }
    const hasErrors = Object.values(errors).some(msg => msg)
    if (typeof bot_test === "string" && bot_test.length>0) {
      console.error("Bot detected. " + JSON.stringify(formData));
      formSent = true;
    } else if (!hasErrors) {
      Object.keys(formData).forEach(function(key){
        let value = formData[key];
        if (typeof value !== null && value.length > 0) {
          description += "**"+key+"**: " + value + "\n";
        }
      });
      const redminePayload = {
        issue: {
          project_id: parseInt(import.meta.env.REDMINE_NEW_CONTACT_PROJECT_ID),
          subject: typeof name === "string" && name.length > 0 ? name : email,
          description: description
        }
      };
      console.error(redminePayload);
      const redmineResponse = await fetch(import.meta.env.REDMINE_NEW_QUOTE_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Redmine-API-Key': import.meta.env.REDMINE_NEW_QUOTE_API_KEY
        },
        body: JSON.stringify(redminePayload)
      });
      const redmineData = await redmineResponse.json();
      formSent = true;
      if (redmineResponse.status === 201) {
        
      } else {
        if ('errors' in redmineData) {
          errors.form = String(redmineResponse.status) + " " + JSON.stringify(redmineData.errors);
        } else {
          errors.form = String(redmineResponse.status);
        }
        console.error(redmineResponse);
        console.error(redmineData);
      }
    } else {
      console.error(errors);
    }
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}
---

<BaseLayout title={t('Contact')} description={t('Contact us')}>
<section id="contact-info" class="py-16 bg-zinc-50 dark:bg-[#0c0c0f]">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-8xl mx-auto mb-16 reveal-on-scroll">
      <div class="grid grid-cols-1 lg:grid-rows-1 gap-6 max-w-7xl mx-auto">
        <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll min-h-[320px] lg:min-h-0">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 lg:grid-rows-1 gap-6 max-w-7xl mx-auto">
            <div class="col-span-1">
              <h3 class="text-3xl brand-font font-bold text-zinc-900 dark:text-white mb-4 z-10">hypernova</h3>
              <p>{t('VAT ID')}: <span class="font-bold">{t('FI29256763')}</span></p>
              <p>{t('Our postal address is')}</p>
              <address class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10 left-1/2">
                Hypernova Oy<br />
                {t('PO box')} 16<br />
                80101, Joensuu, {t('FINLAND')}<br />
              </address>
            </div>
            <div class="col-span-1">
              <h4 class="text-2xl text-zinc-900 dark:text-white mb-4 z-10">{t('Billing information')}</h4>
              <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
                {t('E-invoice number / EDI code')}: 003729256763<br />
                {t('E-invoice operator')}: 003723327487 (Apix Messaging Oy)<br />
                IBAN: FI50 7997 7996 3875 56<br />
                BIC: HOLVFIHH
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section id="form" class="py-32 bg-zinc-50 dark:bg-[#0c0c0f] border-y border-zinc-200 dark:border-zinc-800 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-zinc-200/50 via-transparent to-transparent dark:from-primary-900/10 dark:via-transparent dark:to-transparent"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
        {t('Contact us')}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-1 lg:grid-rows-[minmax(260px,auto)_minmax(280px,auto)] gap-6 max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto py-12 reveal-on-scroll" style={formSent ? '' : 'display:none'}>
        <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
          {t('Thank you for submitting your request.')}
        </h2>
        <p style={errors.form ? 'display:none' : ''} class="text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
          {t('We will be in contact to the email address you provided.')}
        </p>
        <p style={errors.form ? '' : 'display:none'}class="text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
          {t('Unfortunately an error occurred. Please contact us at')} <a href="mailto:contact@hypernova.fi">contact@hypernova.fi</a> {t('and provide the following error message.')}

          <div style={errors.form ? '' : 'display:none'} class="mt-10 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-3xl p-8 flex flex-col relative transform shadow-2xl shadow-primary-500/10 reveal-on-scroll" style="transition-delay: 100ms;">
            {errors.form}
          </div>
        </p>
      </div>
      <form method="POST" action="#request-a-quote" style={formSent && errors.form.length === 0 ? 'display:none': ''} >
        <div class="glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-3xl p-8 flex flex-col relative transform shadow-2xl shadow-primary-500/10 reveal-on-scroll" style="transition-delay: 100ms;">
          <div class="grid md:grid-cols-4 sm:grid-cols-1 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Contact information')}</Badge> 
            </div>
            <label class="p-3 mt-5 col-span-1">{t('Name')}</label><input type="text" name="name" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.name} required /><div class="md:col-span-2"></div>
            {errors.name && <p class="col-span-1 md:col-span-4 text-red-800">{errors.name}</p>}
            <label class="p-3 mt-5 col-span-1">{t('Organization')}</label><input type="text" name="organization" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.organization} /><div class="md:col-span-2"></div>
            {errors.organization && <p class="col-span-1 md:col-span-4 text-red-800">{errors.organization}</p>}
            <label class="p-3 mt-5 col-span-1">{t('E-mail')}</label><input type="email" name="email" class="mt-5 p-3 col-span-1 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1" value={formData.email} required /><div class="md:col-span-2"></div>
            <span class="hidden"><input type="text" name="website" value={formData.website} /></span>
            {errors.email && <p class="col-span-1 md:col-span-4 text-red-800">{errors.email}</p>}
          </div>
          <div class="grid grid-cols-2 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('How can we help you?')}</Badge> 
            </div>
            <textarea name="content" rows="5" class="p-3 sm:col-span-1 col-span-2 bg-zinc-300 text-zinc-900 border border-1 border-primary-500 rounded-lg shadow-2x1">{formData.content}</textarea>
          </div>
          <div class="grid grid-cols-2 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 -tranzinc-x-1/2">
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Ready?')}</Badge> 
            </div>
            <Button type="submit" class="border-2 col-span-2 border-primary-500">{t('Submit')}</Button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>
</div>

</BaseLayout>
