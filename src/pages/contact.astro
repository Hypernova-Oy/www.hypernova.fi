---
import Badge from '../components/Badge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FormValidation from '../components/FormValidation.astro';

import { resolvePath } from '../utils/navigation';
import { FALLBACK_LANG, isLanguage, type Language } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import {
  checkFormToken,
  cleanValues,
  clientId,
  createFormToken,
  detectSpam,
  isRateLimited,
  safeClientAddress,
  MAX_MESSAGE_LENGTH,
} from '../utils/form-protection';

export const prerender = false;

const i18n = {
  fi: {
    'Contact': 'Yhteystiedot',
    'Contact us': 'Ota yhteyttä',
    'Are you contacting us about Koha hosting? Please use the': 'Oletko yhteydessä Kohan pilvipalvelusta? Käytä sen sijaan',
    'Koha hosting quote form': 'Kohan pilvapalvelun tarjouspyyntölomaketta',
    'instead - it asks for the details we need to send you a quote.': '- se kysyy tiedot, jotka tarvitsemme tarjouksen lähettämiseen.',
    'VAT ID': 'Y-tunnus',
    'FI29256763': '2925676-3',
    'Postal address': 'Postiosoite',
    'FINLAND': 'SUOMI',
    'PO box': 'PL',
    'Billing information': 'Laskutustiedot',
    'E-invoice number / EDI code': 'Verkkolaskuosoite / OVT-tunnus',
    'E-invoice operator': 'Verkkolaskuoperaattori',
    'Contact information': 'Yhteystiedot',
    'Name': 'Nimi',
    'Organization': 'Organisaatio',
    'E-mail': 'Sähköposti',
    'How can we help you?': 'Miten voimme auttaa?',
    'Ready?': 'Valmista?',
    'Submit': 'Lähetä yhteydenottopyyntö',
    'Please enter your name. ': 'Syötä nimesi. ',
    'Please enter an email address. ': 'Syötä sähköpostiosoitteesi. ',
    'Thank you for submitting your request.': 'Kiitos yhteydenotostasi.',
    'We will reply to the e-mail address you provided.': 'Olemme yhteydessä antamaasi sähköpostiosoitteeseen.',
    'Unfortunately an error occurred. Please try again later or contact us by post (our address is above) and include the following error message.':
      'Valitettavasti lomakkeen lähetys epäonnistui. Yritä myöhemmin uudelleen tai ota yhteyttä postitse (osoitteemme on yllä) ja liitä mukaan seuraava virheviesti.',
    'Too many submissions from this connection. Please try again later or contact us by post (our address is above).':
      'Tältä yhteydeltä on tullut liian monta lähetystä. Yritä myöhemmin uudelleen tai ota yhteyttä postitse (osoitteemme on yllä).',
  }
};
const t = useTranslations(i18n, Astro);
const lang: Language = isLanguage(Astro.locals.lang) ? Astro.locals.lang : FALLBACK_LANG;

const formId = 'contact' as const;
const errors = { name: "", email: "", organization: "", form: "" };
let formSent = false;
let rateLimited = false;
let description = "";
const formData = {
    name: "",
    organization: "",
    email: "",
    website: "",
    content: "",
};

// A signed, timestamped token for this page load. It is re-used when the form is
// rendered again after a validation error, so fixing a typo quickly is not
// mistaken for an automated submission.
let formToken = createFormToken(formId);

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const raw: Record<string, string> = {};
    data.forEach(function(value, key){
      if (typeof value === "string") {
        raw[key] = value;
      }
    });
    const fields = cleanValues(raw);
    Object.keys(formData).forEach(function(key){
      if (key in fields) {
        (formData as Record<string, string>)[key] = fields[key];
      }
    });

    const name = fields.name;
    const email = fields.email;
    const bot_test = fields.website;

    if (typeof name !== "string" || name.length < 1) {
      errors.name += t("Please enter your name. ");
    }
    if (typeof email !== "string" || email.length < 6 || email.search(/@/) < 0) {
      errors.email += t("Please enter an email address. ");
    }
    const hasErrors = Object.values(errors).some(msg => msg)

    const tokenReason = checkFormToken(raw.form_token, formId);
    if (tokenReason === null || tokenReason === "too-fast") {
      formToken = raw.form_token as string;
    }

    // Only submissions that pass validation are judged, so a visitor fixing a
    // mistake still gets the field messages.
    const spamReason = hasErrors
      ? null
      : detectSpam({ formId, request: Astro.request, host: Astro.url.host, raw, fields });

    if (hasErrors) {
      // Validation errors are rendered back to the visitor, nothing to log.
    } else if ((typeof bot_test === "string" && bot_test.length > 0) || spamReason) {
      // Bot signals are answered exactly like a real submission so scripts learn
      // nothing, but Redmine is never contacted. The reason is safe to log: it
      // carries no visitor data.
      console.warn("Contact form submission dropped:", spamReason ?? "honeypot");
      formSent = true;
    } else if (isRateLimited(clientId(Astro.request, safeClientAddress(() => Astro.clientAddress)))) {
      // The visitor is told, unlike with a bot signal: a real person may have hit
      // the limit by accident and should not lose their message silently.
      rateLimited = true;
    } else {
      Object.keys(formData).forEach(function(key){
        const value = fields[key];
        if (typeof value === "string" && value.length > 0) {
          description += "**"+key+"**: " + value + "\n";
        }
      });
      const redminePayload = {
        issue: {
          project_id: parseInt(import.meta.env.REDMINE_NEW_CONTACT_PROJECT_ID),
          subject: name.length > 0 ? name : email,
          description: description
        }
      };
      const redmineResponse = await fetch(import.meta.env.REDMINE_NEW_QUOTE_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Redmine-API-Key': import.meta.env.REDMINE_NEW_QUOTE_API_KEY
        },
        body: JSON.stringify(redminePayload)
      });
      const redmineData = await redmineResponse.json();
      formSent = true;
      if (redmineResponse.status === 201) {
        // Issue created in Redmine.
      } else {
        if ('errors' in redmineData) {
          errors.form = String(redmineResponse.status) + " " + JSON.stringify(redmineData.errors);
        } else {
          errors.form = String(redmineResponse.status);
        }
        // Log the status only - never the submitted personal data.
        console.error('Redmine contact issue creation failed with status', redmineResponse.status);
      }
    }
  } catch (error) {
    console.error('Contact form submission failed', error);
  }
}
---

<BaseLayout title={t('Contact')} description={t('Contact us')}>
<section id="contact-info" class="py-16 bg-zinc-50 dark:bg-night-soft">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-8xl mx-auto mb-16 reveal-on-scroll">
      <div class="grid grid-cols-1 lg:grid-rows-1 gap-6 max-w-7xl mx-auto">
        <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll min-h-[320px] lg:min-h-0">
          <!-- w-full, not mx-auto: this panel is a column flex container, so an auto inline
               margin would shrink the grid to its content and centre it, leaving the panel
               half empty above 768px. -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 lg:grid-rows-1 gap-6 w-full">
            <div class="col-span-1">
              <h3 class="text-3xl brand-font font-bold text-zinc-900 dark:text-white mb-6 z-10">hypernova</h3>
              <!--
                Label above value, one row per detail. The old block put the VAT ID at body
                size, then the sentence "Our postal address is", then the address in a larger
                grey - three styles in one column, with no two values starting at the same
                place. A short uppercase label in front of each value gives the two columns
                the same shape, and stacked rows (rather than a side-by-side label column)
                leave the IBAN room on a narrow screen.
              -->
              <dl class="space-y-6">
                <div>
                  <dt class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-primary-200 mb-1">
                    {t('VAT ID')}
                  </dt>
                  <dd class="font-mono text-lg text-zinc-600 dark:text-zinc-400">{t('FI29256763')}</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-primary-200 mb-1">
                    {t('Postal address')}
                  </dt>
                  <dd>
                    <!-- <address> is italic by default; the billing column next to it never was. -->
                    <address class="not-italic text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
                      Hypernova Oy<br />
                      {t('PO box')} 16<br />
                      80101 Joensuu<br />
                      {t('FINLAND')}
                    </address>
                  </dd>
                </div>
              </dl>
            </div>
            <div class="col-span-1 md:border-l md:border-zinc-200 md:pl-8 dark:md:border-night-line">
              <h4 class="text-2xl text-zinc-900 dark:text-white mb-6 z-10">{t('Billing information')}</h4>
              <!-- Codes stay verbatim: they are copied into an invoicing system, so nothing
                   here is spaced out or wrapped for looks. font-mono keeps the columns of
                   digits aligned and marks them as data rather than prose. -->
              <dl class="space-y-6">
                <div>
                  <dt class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-primary-200 mb-1">
                    {t('E-invoice number / EDI code')}
                  </dt>
                  <dd class="font-mono text-lg text-zinc-600 dark:text-zinc-400">003729256763</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-primary-200 mb-1">
                    {t('E-invoice operator')}
                  </dt>
                  <dd class="text-lg text-zinc-600 dark:text-zinc-400">
                    <span class="font-mono">003723327487</span>
                    <span class="text-base text-zinc-500 dark:text-primary-200">(Apix Messaging Oy)</span>
                  </dd>
                </div>
                {/*
                  The Finnish name of the IBAN row, hidden rather than printed: /search-index.json
                  indexes the text of the page, so a search for "Tilinumero" points at this row and
                  the snippet of the result shows the number the word stands for. Only the Finnish
                  page carries it, and the note is an Astro comment rather than an HTML one so that
                  the word is in no served markup of the English page either.
                */}
                <div>
                  <dt class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-primary-200 mb-1">
                    IBAN{lang === 'fi' && <span class="sr-only">Tilinumero</span>}
                  </dt>
                  <dd class="font-mono text-lg text-zinc-600 dark:text-zinc-400">FI50 7997 7996 3875 56</dd>
                </div>
                {/* "Pankki" (bank) stands for the BIC the same way. */}
                <div>
                  <dt class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-primary-200 mb-1">
                    BIC{lang === 'fi' && <span class="sr-only">Pankki</span>}
                  </dt>
                  <dd class="font-mono text-lg text-zinc-600 dark:text-zinc-400">HOLVFIHH</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section id="form" class="py-32 bg-zinc-50 dark:bg-night-soft border-y border-zinc-200 dark:border-night-line relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-zinc-200/50 via-transparent to-transparent dark:from-primary-900/10 dark:via-transparent dark:to-transparent"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
        {t('Contact us')}
      </h2>
      <!-- Koha hosting is quoted through a form of its own, so a visitor whose question is
           about it is pointed at that form before the fields of this one. -->
      <p class="text-lg text-zinc-600 dark:text-zinc-400 font-sans">
        {t('Are you contacting us about Koha hosting? Please use the')} <a href={resolvePath('/koha/#request-a-quote')} class="link-inline">{t('Koha hosting quote form')}</a> {t('instead - it asks for the details we need to send you a quote.')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-1 lg:grid-rows-[minmax(260px,auto)_minmax(280px,auto)] gap-6 max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto py-12 reveal-on-scroll" style={formSent ? '' : 'display:none'}>
        <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-zinc-900 dark:text-white mb-6">
          {t('Thank you for submitting your request.')}
        </h2>
        <p style={errors.form ? 'display:none' : ''} class="text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
          {t('We will reply to the e-mail address you provided.')}
        </p>
        <p style={errors.form ? '' : 'display:none'} class="text-left text-xl text-zinc-600 dark:text-zinc-400 font-sans">
          {t('Unfortunately an error occurred. Please try again later or contact us by post (our address is above) and include the following error message.')}
        </p>
        <pre style={errors.form ? 'transition-delay: 100ms;' : 'display:none'} class="mt-10 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-3xl p-8 flex flex-col relative transform shadow-2xl shadow-primary-500/10 reveal-on-scroll overflow-x-auto whitespace-pre-wrap">{errors.form}</pre>
      </div>
      {rateLimited && (
        <p role="alert" data-form-rate-limited class="max-w-3xl mx-auto mb-8 text-left text-xl text-red-800 dark:text-red-400">
          {t('Too many submissions from this connection. Please try again later or contact us by post (our address is above).')}
        </p>
      )}
      <form method="POST" action="#form" novalidate data-validate style={formSent && errors.form.length === 0 ? 'display:none': ''} >
        <div class="glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-3xl p-8 flex flex-col relative transform shadow-2xl shadow-primary-500/10 reveal-on-scroll" style="transition-delay: 100ms;">
          <div class="grid md:grid-cols-4 sm:grid-cols-1 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform" >
            <!-- The section label straddles the top border of its panel. It is centred on the
                 panel and wraps inside it, so it never hangs off the edge of a narrow screen. -->
            <div class="absolute -top-4 inset-x-4 flex justify-center text-center" data-form-section>
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Contact information')}</Badge> 
            </div>
            <label class="p-3 mt-5 col-span-1">{t('Name')}</label><input type="text" name="name" maxlength="120" class="form-field mt-5 p-3 col-span-1" value={formData.name} required data-error-message={t('Please enter your name. ')} /><div class="md:col-span-2"></div>
            {errors.name && <p class="col-span-1 md:col-span-4 text-red-800">{errors.name}</p>}
            <p id="contact-error-name" class="col-span-1 md:col-span-4 text-red-800" data-error-for="name" hidden></p>
            <label class="p-3 mt-5 col-span-1">{t('Organization')}</label><input type="text" name="organization" maxlength="120" class="form-field mt-5 p-3 col-span-1" value={formData.organization} /><div class="md:col-span-2"></div>
            {errors.organization && <p class="col-span-1 md:col-span-4 text-red-800">{errors.organization}</p>}
            <label class="p-3 mt-5 col-span-1">{t('E-mail')}</label><input type="email" name="email" maxlength="254" class="form-field mt-5 p-3 col-span-1" value={formData.email} required data-error-message={t('Please enter an email address. ')} /><div class="md:col-span-2"></div>
            <!-- Bot traps: hidden from people and screen readers, but not from scripts. -->
            <div aria-hidden="true" class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden">
              <label>Website<input type="text" name="website" value={formData.website} tabindex="-1" autocomplete="off" /></label>
            </div>
            <input type="hidden" name="form_token" value={formToken} />
            {errors.email && <p class="col-span-1 md:col-span-4 text-red-800">{errors.email}</p>}
            <p id="contact-error-email" class="col-span-1 md:col-span-4 text-red-800" data-error-for="email" hidden></p>
          </div>
          <div class="grid grid-cols-2 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 inset-x-4 flex justify-center text-center" data-form-section>
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('How can we help you?')}</Badge> 
            </div>
            <textarea name="content" rows="5" maxlength={MAX_MESSAGE_LENGTH} class="form-field p-3 sm:col-span-1 col-span-2">{formData.content}</textarea>
          </div>
          <div class="grid grid-cols-2 glass-panel border-2 border-primary-500 dark:border-primary-500 rounded-1xl p-8 flex flex-col relative transform mt-10" >
            <div class="absolute -top-4 inset-x-4 flex justify-center text-center" data-form-section>
              <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm">{t('Ready?')}</Badge> 
            </div>
            <Button type="submit" class="border-2 col-span-2 border-primary-500">{t('Submit')}</Button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

  <FormValidation />
</BaseLayout>
