---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/LegalDocument.astro';
import { termsOfService } from '../legal/terms-of-service';
import { isLanguage, type Language } from '../i18n/ui';

const lang: Language = isLanguage(Astro.locals.lang) ? Astro.locals.lang : 'gb';
---

<BaseLayout title={termsOfService.title[lang]} description={termsOfService.description[lang]}>
  <LegalDocument document={termsOfService} />
</BaseLayout>
