---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

import { Image } from 'astro:assets';
import toveri1 from "../images/toveri-wood.png";
import toveri2 from "../images/toveri-eno.png";
import toveri3 from "../images/toveri-pin.png";
import toveri4 from "../images/toveri-engravings.png";
import { useTranslations } from '../i18n/utils';

export const prerender = false;

const i18n = {
  fi: {
    'Toveri Access Control Device': 'Toveri-kulunvalvontalaite',
    'Open source hardware and software for library access control': 'Avoimen lähdekoodin ja laitteiston kulunvalvonta kirjastoihin',
    'Toveri is a fully open source access control device, built by professional library software developers. It uses common open standards, which keeps it easy to use, install and maintain': 'Toveri on täysin avoimen lähdekoodin kulunvalvontalaite, jonka on toteuttanut ammattimainen kirjasto-ohjelmistokehityksen tiimi. Laite käyttää yleisiä ja avoimia standardeja, mikä takaa helpon käytettävyyden, asennettavuuden ja ylläpidettävyyden',
    'In a self-service library the Toveri device waits outside the main door. It reads your library card, asks for your PIN code and requests access from your library system. If the system grants access, the door opens and you may enter. Self-service libraries let patrons use the library outside your opening hours, and Toveri has served them reliably for more than a decade': 'Itsepalvelukirjastossa Toveri-kulunvalvontalaite odottaa kirjaston pääoven ulkopuolella. Se lukee kirjastokorttisi, kysyy PIN-koodisi ja pyytää käyttöoikeutta kirjastojärjestelmästä. Jos järjestelmä myöntää käyttöoikeuden, ovi avautuu ja voit astua sisään. Itsepalvelukirjastot mahdollistavat kirjaston käytön myös aukioloaikojen ulkopuolella, ja Toveri on palvellut niitä luotettavasti jo yli vuosikymmenen',
    'Toveri is Finnish design and quality. It is built to withstand extreme weather, from heat to hard frost. We give the device a two-year warranty': 'Toveri on suomalaista suunnittelu- ja laatutyötä. Se on suunniteltu kestämään äärimmäisiä sääolosuhteita aina helteestä kovaan pakkaseen. Myönnämme laitteelle kahden vuoden takuun',
    'As a free and open source project, Toveri can receive modifications and other contributions from anyone in the world. See our': 'Vapaana ja avoimen lähdekoodin projektina Toveri voi vastaanottaa muutoksia ja parannuksia keneltä tahansa maailmassa. Katso',
    'for more detailed information and technical documentation of the underlying technology': 'saadaksesi tarkempaa tietoa ja teknistä dokumentaatiota taustalla olevasta teknologiasta',
    'Toveri supports PIN code keypads': 'Toveri tukee PIN-koodinäppäimistöä',
    'Custom engravings': 'Yksilölliset kaiverrukset',
    'Toveri supports multiple casing materials': 'Toveri tukee useita kotelomateriaaleja',
    'First generation Toveri in use at Eno Library': 'Ensimmäisen sukupolven Toveri käytössä Enon kirjastossa',
    'Choose the material and colour from our partner catalogue, and we will engrave the design of your choice, for example your logo': 'Valitse materiaali ja väri yhteistyökumppanimme valikoimasta, niin kaiverramme laitteeseen haluamasi kuvion, esimerkiksi logosi',
    'Toveri is licensed under CERN OHL and GPLv3. Our clients have the right to modify Toveri software or hardware, as long as the new or modified versions are shared the same way. Once purchased, the device is the property of our client. Note that the device contains components whose patents or copyrights remain with their original manufacturers': 'Toveri on soveltuvin osin CERN OHL- ja GPLv3-lisensoitu. Asiakkaallamme on oikeus muokata Toverin ohjelmistoa tai laitteistoa, sillä edellytyksellä että muutokset jaetaan vapaasti saataville. Hankittu laite on kokonaisuudessaan asiakkaamme omaisuutta. Laite sisältää valmiita komponentteja, joiden tekijänoikeudet säilyvät niiden alkuperäisillä omistajilla',
    'Contact us': 'Ota yhteyttä'
  }
};
const t = useTranslations(i18n, Astro);
---

<BaseLayout title={t('Toveri Access Control Device')} description={t('Open source hardware and software for library access control')}>
    <div class="bg-zinc-50 dark:bg-night-soft border-b border-zinc-200 dark:border-night-line py-16 md:py-24 transition-colors">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-4">{t('Toveri Access Control Device')}</h1>
        <p class="text-xl text-zinc-600 dark:text-zinc-400">
          {t('Open source hardware and software for library access control')}
        </p>
      </div>
    </div>
    <section id="lainuri-info" class="py-16 bg-zinc-50 dark:bg-night-soft">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-8xl mx-auto mb-16 reveal-on-scroll">
        <div class="grid grid-cols-1 lg:grid-rows-1 gap-6 max-w-7xl mx-auto">
            <div class="glass-panel rounded-3xl p-8 flex flex-col hover-glow reveal-on-scroll min-h-[320px] lg:min-h-0">
            <div class="grid grid-cols-1 lg:grid-rows-1 gap-6 max-w-7xl mx-auto">
                <div class="col-span-1">
                    <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
                        {t('Toveri is a fully open source access control device, built by professional library software developers. It uses common open standards, which keeps it easy to use, install and maintain')}.
                    </p>
                    <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
                        {t('In a self-service library the Toveri device waits outside the main door. It reads your library card, asks for your PIN code and requests access from your library system. If the system grants access, the door opens and you may enter. Self-service libraries let patrons use the library outside your opening hours, and Toveri has served them reliably for more than a decade')}.
                    </p>
                    <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
                        {t('Toveri is Finnish design and quality. It is built to withstand extreme weather, from heat to hard frost. We give the device a two-year warranty')}.
                    </p>
                    <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
                        {t('As a free and open source project, Toveri can receive modifications and other contributions from anyone in the world. See our')} <a href="https://github.com/Hypernova-Oy/emb-toveri" class="link-inline" target="_blank">GitHub repository</a> {t('for more detailed information and technical documentation of the underlying technology')}.
                    </p>
                    <div class="grid grid-cols-2 grid-rows-2 gap-6 mx-12">
                        <div class="col-span-2 lg:col-span-1">
                            <Image src={toveri3} alt={t('Toveri Access Control Device')} height={500} />
                            <p class="lg:col-span-1 gap-6">{t('Toveri supports PIN code keypads')}.</p>
                        </div>
                        <div class="col-span-2 lg:col-span-1 gap-6 mx-12">
                            <Image src={toveri4} alt={t('Toveri Access Control Device')} height={500} />
                            <p class="lg:col-span-1 gap-6">{t('Custom engravings')}.</p>
                        </div>
                        <div class="col-span-2 lg:col-span-1">
                            <Image src={toveri1} alt={t('Toveri Access Control Device')} height={500} />
                            <p class="lg:col-span-1 gap-6">{t('Toveri supports multiple casing materials')}.</p>
                        </div>
                        <div class="col-span-2 lg:col-span-1 gap-6 mx-12">
                            <Image src={toveri2} alt={t('Toveri Access Control Device')} height={500} />
                            <p class="lg:col-span-1 gap-6">{t('First generation Toveri in use at Eno Library')}.</p>
                        </div>
                    </div>
                    <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10 my-12">
                        {t('Choose the material and colour from our partner catalogue, and we will engrave the design of your choice, for example your logo')}.
                    </p>
                    <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed mb-8 flex-grow z-10">
                        {t('Toveri is licensed under CERN OHL and GPLv3. Our clients have the right to modify Toveri software or hardware, as long as the new or modified versions are shared the same way. Once purchased, the device is the property of our client. Note that the device contains components whose patents or copyrights remain with their original manufacturers')}.
                    </p>
                    <Button href="/contact/#form" variant="primary" size="lg" class="w-full mt-12 sm:w-auto text-lg px-8 py-4 shadow-xl shadow-primary-500/20">
                        {t('Contact us')}
                    </Button>
                </div>
            </div>
        </div>
        </div>
    </div>
    </div>
    </section>

</BaseLayout>
