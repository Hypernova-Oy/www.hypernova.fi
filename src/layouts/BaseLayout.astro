---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_DESCRIPTION_I18N, SITE_URL } from '../config';
import { resolvePath } from '../utils/navigation';
import { FALLBACK_LANG, resolveLanguage, type i18n } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
/*
 * The theme script is inlined into the document exactly as it is written here (see the
 * <script> in the head), and astro.config.mjs reads this same file to hash it into
 * `script-src`.
 */
import themeInit from '../scripts/theme-init.js?raw';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
}

/**
 * The social preview card every page falls back to. It is composed at exactly this size by
 * scripts/generate-og-image.mjs, which is what lets the og:image tags below declare its
 * dimensions, so a crawler can lay out the large card before fetching the file.
 */
const DEFAULT_IMAGE = '/og-image.png';
const DEFAULT_IMAGE_WIDTH = 1200;
const DEFAULT_IMAGE_HEIGHT = 630;

const i18n: i18n = {
  fi: {}
};
i18n['fi'][SITE_DESCRIPTION] = SITE_DESCRIPTION_I18N['fi'];
const t = useTranslations(i18n, Astro);

const {
  title,
  description = t(SITE_DESCRIPTION),
  image = DEFAULT_IMAGE,
  type = 'website',
  publishedDate,
  modifiedDate,
  author,
} = Astro.props;

const siteURL = SITE_URL.endsWith('/') ? SITE_URL : `${SITE_URL}/`;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, siteURL).href;
const imageURL = new URL(image, siteURL).href;
const fullTitle = `${title} | ${SITE_TITLE}`;
const robotsContent = 'index, follow';
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: imageURL,
        url: canonicalURL,
        datePublished: publishedDate?.toISOString(),
        dateModified: (modifiedDate ?? publishedDate)?.toISOString(),
        author: author
          ? {
              '@type': 'Person',
              name: author,
            }
          : undefined,
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          logo: {
            '@type': 'ImageObject',
            url: new URL('/favicon.png', siteURL).href,
          },
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description,
        url: siteURL,
      };

// The UI language is resolved per request in src/middleware.ts, and it is also the code the document
// carries as its `lang` attribute: both codes of src/i18n/ui.ts - `en` and `fi` - are real language
// tags, which is what that attribute has to be. It is the tag a screen reader picks a voice with,
// and the one the browser hyphenates and spell-checks with. The name the previous site used for
// English (`gb`) is read as `en` before it reaches here, and is never written back.
const documentLang = resolveLanguage(Astro.locals.lang) ?? FALLBACK_LANG;
---

<!DOCTYPE html>
<html lang={documentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!--
      Icon set: the Hypernova mark. favicon.svg carries both the light and the dark
      rendition of the mark and swaps them with prefers-color-scheme, so the mark
      stays visible on light and on dark browser chrome; it is declared first, and as
      scalable, for the browsers that pick it. Chromium only honours that in-file
      switch when the SVG is the icon it selects: a 16px ICO frame or the 32x32 PNG
      outranks it, which used to pin the dark mark to the tab on dark browser chrome.
      The rasters therefore get their href from the script below, which follows the
      same media query. The PNG is the 32x32 raster the hypernova.fi production site
      serves, byte for byte (the only size production ships), and favicon.ico is a real
      16x16 + 32x32 container for the browsers and tools that ask for /favicon.ico by
      name; favicon-dark.png and favicon-dark.ico are those two files with the
      white-gradient rendition instead. Nothing is lost without JavaScript: every link
      then keeps the light rendition it is declared with, and `media`-scoped icon links
      are deliberately avoided because browsers that ignore `media` would show the
      white mark on light browser chrome.
    -->
    <link rel="icon" type="image/svg+xml" sizes="any" href={resolvePath('/favicon.svg')} />
    <link
      rel="icon"
      id="favicon-raster"
      type="image/png"
      sizes="32x32"
      href={resolvePath('/favicon.png')}
      data-light={resolvePath('/favicon.png')}
      data-dark={resolvePath('/favicon-dark.png')}
    />
    <link
      rel="icon"
      id="favicon-legacy"
      href={resolvePath('/favicon.ico')}
      data-light={resolvePath('/favicon.ico')}
      data-dark={resolvePath('/favicon-dark.ico')}
      sizes="16x16 32x32"
    />
    <link rel="apple-touch-icon" href={resolvePath('/favicon.png')} />
    <script>
      /*
       * What the layout itself has to do in the browser. It is a file rather than an `is:inline`
       * block because the Content Security Policy allows an inline script by hash and nothing
       * else: a script written by hand into every document has one hash to keep in step with its
       * code, and this one is not worth that. The paths below cannot come from `resolvePath` -
       * that runs at build time - so they are `data-` attributes on the links above, the same way
       * the palette carries its base path in `data-search-base`.
       *
       * 1. The rasters. Browser chrome picks the tab icon from the links above, and Chromium's
       *    pick is a raster rather than the theme-aware SVG, so both rasters are kept on the
       *    scheme the browser reports (which also follows an OS theme change while the page is
       *    open). The elements are looked up on every call: a swap replaces them.
       *
       * 2. The `default` Trusted Types policy. The directive is in force site-wide (see the
       *    `security.csp` comment in astro.config.mjs) and Astro's view transition router is not
       *    Trusted-Types-aware: on every client-side navigation it re-creates the scripts of the
       *    page it swapped in by assigning `script.innerHTML` (node_modules/astro/dist/
       *    transitions/router.js, `runScripts`), which the browser refuses with a TypeError
       *    unless a policy named `default` is there to take the string. It is a pass-through and
       *    grants nothing an attacker could use: an injected script still has to match a hash in
       *    `script-src` before it runs.
       */
      import { createPolicyOnce } from '../scripts/trusted-types';

      createPolicyOnce('default', {
        createHTML: (html) => html,
        createScript: (script) => script,
        createScriptURL: (url) => url,
      });

      const scheme = window.matchMedia('(prefers-color-scheme: dark)');

      const applyFavicon = () => {
        for (const id of ['favicon-raster', 'favicon-legacy']) {
          const icon = document.getElementById(id);
          const mark = scheme.matches ? icon?.dataset.dark : icon?.dataset.light;

          if (mark) icon?.setAttribute('href', mark);
        }
      };

      applyFavicon();

      if (!window.__zenixFaviconBound) {
        window.__zenixFaviconBound = true;

        scheme.addEventListener('change', applyFavicon);
        document.addEventListener('astro:page-load', applyFavicon);
      }
    </script>
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={resolvePath('/sitemap.xml')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    {image === DEFAULT_IMAGE && (
      <>
        <meta property="og:image:width" content={String(DEFAULT_IMAGE_WIDTH)} />
        <meta property="og:image:height" content={String(DEFAULT_IMAGE_HEIGHT)} />
        <meta property="og:image:alt" content={`${SITE_TITLE} — ${SITE_DESCRIPTION}`} />
      </>
    )}
    <meta property="og:site_name" content={SITE_TITLE} />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {type === 'article' && (modifiedDate ?? publishedDate) && (
      <meta property="article:modified_time" content={(modifiedDate ?? publishedDate)?.toISOString()} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <title>{fullTitle}</title>

    <ClientRouter />

    <!--
      The two families every page is set in (see the `fonts` entries in astro.config.mjs). They
      are declared here, once, so each page preloads them and starts them before the stylesheet
      has been parsed; the brand font of the wordmark is declared by the navbar that draws it.
    -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-grotesk" preload />

    <!--
      Theme initialization, to prevent FOUC and preserve the theme across routes. Light (white)
      is the default look: dark mode is opt-in and only applies once a visitor picks it with the
      navbar toggle, never from the OS colour scheme.

      The code itself lives in src/scripts/theme-init.js and is inlined here with `?raw`, for two
      reasons. It has to run while the document is parsed - a bundled script is a module, and a
      module only runs once the parser is done, which is the flash this exists to prevent - and
      an inline script is only allowed by a hash in `script-src`, which astro.config.mjs computes
      from this very file. As a literal in this layout it was a second copy of that code, and the
      hash it was allowed by then covered bytes the document never contained.
    -->
    <script is:inline data-astro-rerun set:html={themeInit} />
  </head>
  <body class="flex flex-col min-h-screen bg-zinc-50 text-zinc-900 transition-colors duration-300 dark:bg-night dark:text-zinc-100">
    <CommandPalette />
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Global Intersection Observer for Scroll Animations -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;

            const element = entry.target;
            element.classList.add('is-revealed');
            // Stop observing once revealed: re-checking every scroll frame is wasted work.
            observer.unobserve(element);

            // Release the will-change hint after the fade so no layer is kept around.
            const release = () => element.classList.add('reveal-done');
            element.addEventListener('transitionend', release, { once: true });
            window.setTimeout(release, 800);
          });
        }, {
          root: null,
          // Begin the fade slightly before the element scrolls into view, so the
          // animation finishes just off-centre instead of under the reader's eyes.
          rootMargin: '0px 0px 8% 0px',
          // Any overlap counts, never a share of the element: a share makes the trigger
          // depend on how tall the element is. The card stack on /koha/ is 3711px on a
          // phone, so 10% of it is more than the screen can show and the section stayed
          // at opacity 0 - taking the cards inside it, already revealed, down with it -
          // until the visitor scrolled. Over ten screens tall, the share is unreachable
          // and the section would never appear at all.
          threshold: 0
        });

        document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>
