# Redmine integration used by the quote/contact forms (src/pages/koha.astro, src/pages/contact.astro).
# Copy to `.env` and fill in real values. Never commit `.env`.
REDMINE_NEW_QUOTE_ENDPOINT="https://redmine.hypernova.fi/issues.json"
REDMINE_NEW_QUOTE_API_KEY=""
REDMINE_NEW_QUOTE_PROJECT_ID=
REDMINE_NEW_QUOTE_STATUS_ID=
REDMINE_NEW_CONTACT_PROJECT_ID=

# Secret used to sign the anti-bot token of the public forms (src/utils/form-protection.ts).
# Any long random string works, for example the output of `openssl rand -hex 32`.
# Without it a random key is generated at startup: it works, but any form that is
# open while the server restarts is dropped as a precaution.
FORM_TOKEN_SECRET=""
