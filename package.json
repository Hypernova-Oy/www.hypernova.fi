{
  "name": "hypernova",
  "description": "Hypernova Oy website - Free and Open Source software services (Koha, Lainuri, Toveri). This theme is a fork of Zenix theme by farrosfr.",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "homepage": "https://www.hypernova.fi/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hypernova-Oy/zenix.git"
  },
  "bugs": {
    "url": "https://github.com/Hypernova-Oy/zenix/issues"
  },
  "keywords": [
    "astro",
    "tailwindcss",
    "koha",
    "library-system",
    "foss",
    "lainuri",
    "toveri"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "bench:scroll": "node scripts/scroll-bench.mjs",
    "font:subset": "bash scripts/subset-brand-font.sh",
    "index:refresh": "bash scripts/refresh-search-index.sh",
    "og:image": "node scripts/generate-og-image.mjs",
    "start": "node ./dist/server/entry.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:preview": "npm run build && E2E_SERVER=preview E2E_PORT=4399 playwright test",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/node": "^10.1.4",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.8",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  }
}
