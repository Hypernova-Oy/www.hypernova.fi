/*
  # The security headers a static host should send for this site, next to the ones the Apache
  # virtual host is configured with for the deployment in scripts/deploy/install.sh
  # (security_directives()). The Content Security Policy is not here and cannot be: it carries
  # the hashes of the inline scripts and styles of the page being served, so only the app can
  # write it - it is a response header of every page it renders (see the `security.csp` comment
  # in astro.config.mjs).
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
